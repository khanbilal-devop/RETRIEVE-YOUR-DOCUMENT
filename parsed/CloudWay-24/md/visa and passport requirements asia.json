                      "heading": "2. Thailand"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Visa-On-Arrival: For Indian citizens (up to 15 days, fee payable, limited entry points)",
                        "depth": 0
                      },
                      {
                        "text": "E-Visa: Option available",
                        "depth": 0
                      },
                      {
                        "text": "Requirements:  Proof of accommodation, funds, return ticket",
                        "depth": 0
                      }
                    ]
