            },
            "blocks": [],
            "sections": [
              {
                "title": "1. Singapore",
                "level": 3,
                "location": {
                  "line": 21,
                  "heading": "Popular Asian Destinations: Visa Policy Overview"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 22,
                      "heading": "1. Singapore"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Visa-Free:  Indian citizens (up to 30 days for select categories, mostly require e-visa prior to travel)",
                        "depth": 0
                      },
                      {
                        "text": "E-Visa:  Required for Indian passport holders (Apply before travel)",
                        "depth": 0
                      },
                      {
                        "text": "On Arrival:  Not available",
                        "depth": 0
                      },
                      {
                        "text": "Documents:  Proof of funds, return ticket, hotel booking",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
