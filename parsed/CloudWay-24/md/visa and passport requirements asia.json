          {
            "title": "General Guidelines",
            "level": 2,
            "location": {
              "line": 6,
              "heading": "Visa and Passport Requirements for Destinations in Asia"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 8,
                  "heading": "General Guidelines"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Passport Validity:\nMost Asian countries require a passport with at least 6 months’ validity from the date of entry.",
                    "depth": 0
                  },
                  {
                    "text": "Blank Pages:\nAt least 2 blank pages are usually recommended for entry/exit stamps and visas.",
                    "depth": 0
                  },
                  {
                    "text": "Return/Onward Ticket:\nProof of onward or return travel is often required.",
                    "depth": 0
                  },
                  {
                    "text": "Travel Insurance:\nStrongly recommended; mandatory for some destinations.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
