                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Nature of Coverage:\nEnhanced coverage due to higher occupational risk (airborne duties, international layovers, irregular schedules).",
                        "depth": 0
                      },
                      {
                        "text": "Policy Limit Highlights:",
                        "depth": 0
                      },
                      {
                        "text": "Group Life Insurance: INR 1.5 Crore (approx. $180,000)",
                        "depth": 1
                      },
                      {
                        "text": "Accidental Death & Disability: INR 2 Crore (approx. $240,000)",
                        "depth": 1
                      },
                      {
                        "text": "Medical Insurance (per annum): INR 10 Lakh (~$12,000)",
                        "depth": 1
                      },
                      {
                        "text": "Critical Illness Cover: INR 20 Lakh (~$24,000)",
                        "depth": 1
                      },
                      {
                        "text": "Loss of License Benefit: Applicable to Pilots (up to INR 1 Crore/$120,000 for loss of medical certification)",
                        "depth": 1
                      },
                      {
                        "text": "Travel Insurance: Comprehensive, global coverage included",
                        "depth": 1
                      }
                    ]
                  }
