          {
            "title": "Important Notes",
            "level": 2,
            "location": {
              "line": 45,
              "heading": "CloudWay 24 Dangerous Goods Policy"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 47,
                  "heading": "Important Notes"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Liquids, Gels, Aerosols: In hand baggage, each container must be 100ml or less; total may not exceed 1 litre per passenger (packed in a clear, resealable bag).",
                    "depth": 0
                  },
                  {
                    "text": "Electronics: Lithium battery-operated equipment may be carried in both check-in and hand baggage, but spares must only be in hand baggage and protected from short-circuiting.",
                    "depth": 0
                  },
                  {
                    "text": "Sharp Items: Prohibited in hand baggage. Limited sizes and types may go in checked baggage if securely packed.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": [
              {
                "title": "For full list and updates, please refer to CloudWay24.com/dangerous-goods (https://CloudWay24.com/dangerous-goods) or contact our customer service before your journey.",
                "level": 3,
                "location": {
                  "line": 53,
                  "heading": "Important Notes"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 55,
                      "heading": "For full list and updates, please refer to CloudWay24.com/dangerous-goods (https://CloudWay24.com/dangerous-goods) or contact our customer service before your journey."
                    },
                    "text": "Failure to comply may result in removal of prohibited items, denial of boarding, or legal action as per applicable law."
                  }
                ],
                "sections": []
              }
            ]
