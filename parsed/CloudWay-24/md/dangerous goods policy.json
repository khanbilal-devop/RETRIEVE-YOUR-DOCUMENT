              {
                "type": "list",
                "location": {
                  "line": 9,
                  "heading": "General Guidelines"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Prohibited Items: Items that present a risk to health, safety, property, or the environment are strictly prohibited.",
                    "depth": 0
                  },
                  {
                    "text": "Declaration: All dangerous goods must be declared at the time of check-in.",
                    "depth": 0
                  },
                  {
                    "text": "Special Permission: Some items may be allowed only with prior approval.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
