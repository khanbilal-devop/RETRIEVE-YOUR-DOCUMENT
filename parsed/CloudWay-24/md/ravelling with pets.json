      {
        "title": "Travelling with Pets on CloudWay 24",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "Travelling with Pets on CloudWay 24"
            },
            "text": "CloudWay 24 welcomes you and your furry companions aboard! To ensure a pleasant and safe journey for both you and your pet, please review our comprehensive guidelines for travelling with pets."
          }
        ],
        "sections": [
          {
            "title": "General Policy",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "Travelling with Pets on CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 9,
                  "heading": "General Policy"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Eligible Pets: Cats and small dogs (domesticated), in good health and at least 3 months old.",
                    "depth": 0
                  },
                  {
                    "text": "Allowed Routes: Pets are permitted only on international flights operated exclusively by CloudWay 24.",
                    "depth": 0
                  },
                  {
                    "text": "Advance Booking: Notify CloudWay 24 at least 48 hours before departure to reserve a spot for your pet.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Pet Travel Options",
            "level": 2,
            "location": {
              "line": 15,
              "heading": "Travelling with Pets on CloudWay 24"
            },
            "blocks": [
              {
                "type": "table",
                "location": {
                  "line": 17,
                  "heading": "Pet Travel Options"
                },
                "header": [
                  "Option",
                  "In-Cabin",
                  "Checked Baggage (Hold)"
                ],
                "rows": [
                  [
                    "Availability",
                    "Select international routes (duration under 8 hours)",
                    "All direct international flights"
                  ],
                  [
                    "Weight Limit",
                    "Up to 8 kg (incl. carrier)",
                    "Up to 32 kg (incl. carrier)"
                  ],
                  [
