                },
                "ordered": false,
                "items": [
                  {
                    "text": "Opens: 48 hours before scheduled departure",
                    "depth": 0
                  },
                  {
                    "text": "Closes: 2 hours before the flight departure",
                    "depth": 0
                  }
                ]
