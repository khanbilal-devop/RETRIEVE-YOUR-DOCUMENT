                  "heading": "Baggage Drop at the Airport"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Already checked-in online?\nDrop off check-in bags at the CloudWay 24 Baggage Drop Counter at least 60 minutes before departure.",
                    "depth": 0
                  },
                  {
                    "text": "Traveling with only cabin baggage?\nProceed directly to security with your e-boarding pass and valid ID.",
                    "depth": 0
                  }
