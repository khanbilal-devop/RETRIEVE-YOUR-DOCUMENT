                    "text": "Select/modify your seat",
                    "depth": 0
                  },
                  {
                    "text": "Download/print your boarding pass",
                    "depth": 0
                  },
                  {
                    "text": "Add frequent flyer details",
                    "depth": 0
                  },
                  {
                    "text": "Save time and avoid airport queues",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
