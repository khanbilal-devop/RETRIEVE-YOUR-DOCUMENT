                  "heading": "Accommodation Policy"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 62
                    },
                    "text": "For further queries on staff accommodation, access the Crew Portal or contact Crew Scheduling."
                  }
                ],
                "sections": []
              }
