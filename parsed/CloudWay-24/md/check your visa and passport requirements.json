          {
            "title": "How to Check Your Requirements",
            "level": 2,
            "location": {
              "line": 64,
              "heading": "CloudWay 24: Visa and Passport Requirements Guide"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 66,
                  "heading": "How to Check Your Requirements"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Visit CloudWay24.com or use the CloudWay24 App.",
                    "depth": 0
                  },
                  {
                    "text": "Go to \"Plan My Flight\" – select your route and dates.",
                    "depth": 0
                  },
                  {
                    "text": "Click on \"Visa & Passport Info\" on the booking page.",
                    "depth": 0
                  },
                  {
                    "text": "Review requirements for your nationality, transit rules, and special advisories.",
                    "depth": 0
                  }
                ]
              }
