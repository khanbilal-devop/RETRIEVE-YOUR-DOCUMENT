            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 4,
                  "heading": "Check Your Visa and Passport Requirements"
                },
                "text": "Before booking your CloudWay 24 flight, ensure that you meet all entry requirements for your destination. Below is a quick-reference guide for visa and passport requirements for travelers from India to countries in Europe, Western, and Middle East regions."
              }
            ],
            "sections": []
          },
          {
            "title": "General Requirements",
            "level": 2,
            "location": {
              "line": 8,
              "heading": "CloudWay 24: Visa and Passport Requirements Guide"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 10,
                  "heading": "General Requirements"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Passport Validity: Minimum 6 months validity from your date of arrival in most international destinations.",
                    "depth": 0
                  },
                  {
                    "text": "Blank Pages: At least 2 blank pages recommended for visa/stamping.",
                    "depth": 0
                  },
                  {
                    "text": "Return Ticket: Proof of onward/return travel may be required.",
                    "depth": 0
                  },
                  {
                    "text": "Travel Insurance: Mandatory for Schengen (Europe) and recommended for others.",
                    "depth": 0
                  }
                ]
              }
            ],
