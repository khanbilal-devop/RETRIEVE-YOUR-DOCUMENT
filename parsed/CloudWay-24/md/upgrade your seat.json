        "title": "Upgrade Your Seat with CloudWay 24",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "Upgrade Your Seat with CloudWay 24"
            },
            "text": "CloudWay 24 is committed to providing exceptional comfort and flexibility for all our passengers. Whether you seek additional legroom or wish to experience our top-tier service and amenities, upgrading your seat is seamless with CloudWay 24."
          }
        ],
        "sections": [
          {
            "title": "Why Upgrade?",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "Upgrade Your Seat with CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 8,
                  "heading": "Why Upgrade?"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Enhanced Comfort: Enjoy wider seats, additional legroom, and premium cabin amenities.",
                    "depth": 0
                  },
                  {
                    "text": "Exclusive Services: Priority check-in, extra baggage allowance, gourmet meals, and lounge access (varies by cabin).",
                    "depth": 0
                  },
                  {
                    "text": "Personalized Experience: Dedicated crew and a curated selection of entertainment and dining options.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Cabin Classes Available for Upgrade",
            "level": 2,
            "location": {
              "line": 14,
              "heading": "Upgrade Your Seat with CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 16,
                  "heading": "Cabin Classes Available for Upgrade"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "CloudSaver (Economy) → CloudComfort (Premium Economy)",
                    "depth": 0
                  },
                  {
                    "text": "CloudComfort (Premium Economy) → CloudElite (Business Class)",
                    "depth": 0
                  },
                  {
                    "text": "CloudElite (Business Class) → CloudLux (First Class)",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "How to Upgrade Your Seat",
            "level": 2,
            "location": {
              "line": 22,
              "heading": "Upgrade Your Seat with CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 24,
                  "heading": "How to Upgrade Your Seat"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Visit Us Online or Use Our App",
                    "depth": 0
                  },
                  {
                    "text": "Go to CloudWay24.com (https://cloudway24.com) or open the CloudWay24 app.",
                    "depth": 1
                  },
                  {
                    "text": "Login to your account.",
                    "depth": 1
                  },
                  {
                    "text": "Access \"Manage My Flight\"",
                    "depth": 0
                  },
                  {
                    "text": "Select the booking you want to upgrade.",
                    "depth": 1
                  },
                  {
                    "text": "Click on \"Upgrade Your Seat.\"",
                    "depth": 1
                  },
                  {
                    "text": "Choose Your Preferred Cabin Class",
                    "depth": 0
                  },
                  {
                    "text": "View available seats across higher classes.",
                    "depth": 1
                  },
                  {
                    "text": "Review upgrade costs in your preferred currency or pay with your SkyPoints 24 points.",
                    "depth": 1
                  },
                  {
                    "text": "Make Payment",
                    "depth": 0
                  },
                  {
                    "text": "Options: Credit card, Debit card, Netbanking, or SkyPoints 24 points.",
                    "depth": 1
                  },
                  {
                    "text": "Confirm your upgrade.",
                    "depth": 1
                  },
                  {
                    "text": "Receive Confirmation",
                    "depth": 0
                  },
                  {
                    "text": "An updated e-ticket will be sent to your email and app.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Additional Ways to Upgrade",
            "level": 2,
            "location": {
              "line": 45,
              "heading": "Upgrade Your Seat with CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 47,
                  "heading": "Additional Ways to Upgrade"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Airport Upgrade Desk: Ask at the CloudWay 24 counter during check-in (subject to availability).",
                    "depth": 0
                  },
                  {
                    "text": "Upgrade Offers: Look out for special upgrade emails or in-app notifications before your flight.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "SkyPoints 24 Members",
            "level": 2,
            "location": {
              "line": 52,
              "heading": "Upgrade Your Seat with CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 54,
                  "heading": "SkyPoints 24 Members"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Use your accumulated points for full or partial upgrades.",
                    "depth": 0
                  },
                  {
                    "text": "Tier status may offer complimentary or discounted upgrades on select flights (check your benefits).",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Important Notes",
            "level": 2,
            "location": {
              "line": 59,
              "heading": "Upgrade Your Seat with CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 61,
                  "heading": "Important Notes"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Upgrades are subject to seat availability.",
                    "depth": 0
                  },
                  {
                    "text": "Upgrade fees and points required are non-refundable, unless the airline initiates the downgrade.",
                    "depth": 0
                  },
                  {
                    "text": "Terms and conditions apply; refer to our website for details.",
                    "depth": 0
                  }
                ]
              }
            ],
