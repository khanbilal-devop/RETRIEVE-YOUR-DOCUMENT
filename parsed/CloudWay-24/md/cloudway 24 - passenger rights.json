      {
        "title": "CloudWay 24 – Passenger Rights",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "text": "At CloudWay 24, we are committed to providing a safe, comfortable, and reliable travel experience for all our passengers. We believe in transparency, prompt communication, and protecting the interests of our travelers. Below are your fundamental passenger rights when flying with CloudWay 24."
          }
        ],
        "sections": [
          {
            "title": "1. Right to Information",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 9,
                  "heading": "1. Right to Information"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Clear Fare & Fee Disclosure: You are entitled to complete information regarding fares, taxes, surcharges, and any additional fees at the time of booking.",
                    "depth": 0
                  },
                  {
                    "text": "Booking Confirmation & Updates: You will receive prompt electronic confirmation of your booking and any schedule changes, delays, or cancellations.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "2. Right to Care & Assistance",
            "level": 2,
            "location": {
              "line": 14,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 16,
                  "heading": "2. Right to Care & Assistance"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Delays and Cancellations:",
                    "depth": 0
                  },
                  {
                    "text": "If your flight is delayed by more than 2 hours or cancelled, you are entitled to meals, refreshments, and communication assistance (calls, emails).",
                    "depth": 1
                  },
                  {
                    "text": "For overnight delays, you are entitled to hotel accommodation and ground transfers where applicable.",
                    "depth": 1
                  },
                  {
                    "text": "Denied Boarding:",
                    "depth": 0
                  },
                  {
                    "text": "If you are denied boarding involuntarily (e.g., due to overbooking), you will be offered alternate travel options or a full refund, along with compensation as per regulatory norms.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "3. Right to Refunds and Compensation",
            "level": 2,
            "location": {
              "line": 24,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 26,
                  "heading": "3. Right to Refunds and Compensation"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Refunds:",
                    "depth": 0
                  },
                  {
                    "text": "In case of flight cancellation or significant schedule change by CloudWay 24, you are entitled to a full refund or rebooking at no additional cost.",
                    "depth": 1
                  },
                  {
                    "text": "Compensation:",
                    "depth": 0
                  },
                  {
                    "text": "You may be eligible for compensation for flight delays, cancellations, or baggage issues as per DGCA guidelines and international conventions.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "4. Right to Comfort and Special Assistance",
            "level": 2,
            "location": {
              "line": 33,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 35,
                  "heading": "4. Right to Comfort and Special Assistance"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Mobility and Medical Needs:",
                    "depth": 0
                  },
                  {
                    "text": "Passengers with reduced mobility or special requirements can request assistance during booking or up to 48 hours before departure.",
                    "depth": 1
                  },
                  {
                    "text": "Unaccompanied Minors & Elderly:",
                    "depth": 0
                  },
                  {
                    "text": "Safe travel and assistance are available for children and elderly passengers traveling alone.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "5. Right to Baggage Protection",
            "level": 2,
            "location": {
              "line": 42,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 44,
                  "heading": "5. Right to Baggage Protection"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Lost or Damaged Baggage:",
                    "depth": 0
                  },
                  {
                    "text": "If your checked baggage is lost, delayed, or damaged, you are entitled to compensation as per airline and international regulations.",
                    "depth": 1
                  },
                  {
                    "text": "Prompt Tracing and Updates:",
                    "depth": 0
                  },
                  {
                    "text": "Our team will keep you informed and work towards swift baggage location and return.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "6. Right to Privacy and Data Protection",
            "level": 2,
            "location": {
              "line": 51,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 53,
                  "heading": "6. Right to Privacy and Data Protection"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Secure Handling of Data:",
                    "depth": 0
                  },
                  {
                    "text": "All personal and payment data is handled securely as per data protection laws and CloudWay 24 privacy policy.",
                    "depth": 1
                  },
                  {
                    "text": "Right to Opt-out:",
                    "depth": 0
                  },
                  {
                    "text": "You can opt-out of promotional communications at any time.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "7. Right to Customer Support and Redressal",
            "level": 2,
            "location": {
              "line": 60,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 62,
                  "heading": "7. Right to Customer Support and Redressal"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "24/7 Support:",
                    "depth": 0
                  },
                  {
                    "text": "Access to customer support via phone, email, and chat for queries or grievances.",
                    "depth": 1
                  },
                  {
                    "text": "Feedback & Complaint Resolution:",
                    "depth": 0
                  },
                  {
                    "text": "Passengers can submit complaints online or through our app; we aim to resolve all issues in a fair and timely manner.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Need Assistance?",
            "level": 2,
            "location": {
              "line": 69,
              "heading": "CloudWay 24 – Passenger Rights"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 70,
                  "heading": "Need Assistance?"
                },
                "text": "Visit CloudWay24.com/support (https://CloudWay24.com/support) or contact us through the CloudWay24 app for more information on your rights or to lodge a complaint."
              }
            ],
            "sections": []
          },
