        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "CloudWay 24 Fine-Dining Menus (Class-wise Overview)"
            },
            "text": "At CloudWay 24, our commitment to culinary excellence shines through in every class. Our menus are expertly curated, inspired by global cuisines and regional favorites, and updated seasonally to offer diversity and freshness. Here’s a class-wise overview of the fine-dining experience guests can expect on board:"
          }
        ],
        "sections": [
          {
            "title": "CloudLux (First Class)",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "CloudWay 24 Fine-Dining Menus (Class-wise Overview)"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 9,
                  "heading": "CloudLux (First Class)"
                },
                "text": "Overview:\nCloudLux guests enjoy a fully customizable, haute-cuisine experience that blends international delicacies with Indian sophistication. Seasonal tasting menus are available, with options tailored to personal preferences."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 12,
                  "heading": "CloudLux (First Class)"
                },
                "text": "Highlights:"
              },
              {
                "type": "list",
                "location": {
                  "line": 13,
                  "heading": "CloudLux (First Class)"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Multi-course gourmet dining: Starters, main courses, cheese boards, and artisanal desserts",
                    "depth": 0
                  },
                  {
                    "text": "Curated international wine and champagne list",
                    "depth": 0
                  },
                  {
                    "text": "Fresh, premium ingredients: Caviar, Wagyu, fresh seafood, truffles, and global specialty produce",
                    "depth": 0
                  },
                  {
                    "text": "Personalized service: Order à la carte, or request chef’s special creations on select routes",
                    "depth": 0
                  },
                  {
                    "text": "Wide range of world cuisines: French, Italian, Indian Royal, Pan-Asian, Middle Eastern, and more",
                    "depth": 0
                  },
                  {
                    "text": "Exclusive beverage pairings: High-end spirits, aged whiskies, and luxury teas",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "CloudElite (Business Class)",
            "level": 2,
            "location": {
              "line": 22,
              "heading": "CloudWay 24 Fine-Dining Menus (Class-wise Overview)"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 24,
                  "heading": "CloudElite (Business Class)"
                },
                "text": "Overview:\nBusiness travelers in CloudElite enjoy restaurant-style dining with extensive menu options, reflecting both international classics and local dishes."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 27,
                  "heading": "CloudElite (Business Class)"
                },
                "text": "Highlights:"
              },
              {
                "type": "list",
                "location": {
                  "line": 28,
                  "heading": "CloudElite (Business Class)"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Multiple appetizers, mains, and dessert options on every flight",
                    "depth": 0
                  },
                  {
                    "text": "Refined international cuisine: Grilled meats & fish, traditional Indian curries, Asian specialties, and Mediterranean-inspired dishes",
                    "depth": 0
                  },
                  {
                    "text": "Vegetarian and health-focused selections always available",
                    "depth": 0
                  },
                  {
                    "text": "Premium bread basket, cheese plates, and fruit selections",
                    "depth": 0
                  },
                  {
                    "text": "Choice of wine, beer, select spirits, freshly brewed coffee, and teas",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
