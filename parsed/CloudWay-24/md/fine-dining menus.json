                },
                "ordered": false,
                "items": [
                  {
                    "text": "Tasty, balanced meals with a selection of meat, vegetarian, and regional options",
                    "depth": 0
                  },
                  {
                    "text": "Seasonal accompaniments such as salads or yogurts",
                    "depth": 0
                  },
                  {
                    "text": "Choice of two or more main courses per flight",
                    "depth": 0
                  },
                  {
                    "text": "Light dessert and fresh fruit",
                    "depth": 0
                  },
                  {
