          {
            "title": "Excess Baggage Policy",
            "level": 2,
            "location": {
              "line": 33,
              "heading": "CloudWay 24 Baggage Allowance Policy"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 35,
                  "heading": "Excess Baggage Policy"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Excess Baggage: Can be pre-purchased at a discounted rate via the CloudWay24 app or website during booking or under \"Manage My Flight.\"",
                    "depth": 0
                  },
                  {
                    "text": "At Airport: Higher fees apply for additional or overweight baggage checked at the airport counter.",
                    "depth": 0
                  },
                  {
                    "text": "SkyPoints 24 Members: Elite tier members may enjoy additional free allowance—check your SkyPoints 24 tier benefits.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Special Baggage",
            "level": 2,
            "location": {
              "line": 41,
              "heading": "CloudWay 24 Baggage Allowance Policy"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 43,
                  "heading": "Special Baggage"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Sporting equipment and musical instruments accepted as part of checked baggage allowance; items exceeding size/weight limits may attract charges.",
                    "depth": 0
                  },
                  {
                    "text": "Contact customer service for special arrangements or detailed advice.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Important Guidelines",
            "level": 2,
            "location": {
              "line": 48,
              "heading": "CloudWay 24 Baggage Allowance Policy"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 50,
                  "heading": "Important Guidelines"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "All baggage must be properly labeled with your name and contact information.",
                    "depth": 0
                  },
                  {
                    "text": "Carry-on luggage must fit in the overhead bin or under the seat.",
                    "depth": 0
                  },
                  {
                    "text": "Dangerous or prohibited items not allowed.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 54,
                  "heading": "Important Guidelines"
                },
                "text": "For the most up-to-date baggage rules and detailed FAQs, visit CloudWay24.com/Baggage (https://CloudWay24.com/Baggage) or check the \"Baggage Policy\" section in the CloudWay24 app."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 57,
                  "heading": "Important Guidelines"
                },
                "text": "Travel smooth. Travel CloudWay 24 – Seamless Skies, Global Reach."
              }
