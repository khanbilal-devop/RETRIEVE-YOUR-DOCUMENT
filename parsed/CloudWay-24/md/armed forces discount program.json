        "title": "CloudWay 24 | Armed Forces Discount Program",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "CloudWay 24 | Armed Forces Discount Program"
            },
            "text": "CloudWay 24 salutes the service and sacrifice of the armed forces. As part of our commitment to giving back, we offer exclusive discounts for both serving and retired members of the Indian Armed Forces when flying with CloudWay 24."
          }
        ],
        "sections": [
          {
            "title": "🌟 What’s Included?",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "CloudWay 24 | Armed Forces Discount Program"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 9,
                  "heading": "🌟 What’s Included?"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Flat 15% Discount on base airfare for all eligible serving and retired armed forces personnel.",
                    "depth": 0
                  },
                  {
                    "text": "Applicable for CloudSaver (Economy), CloudComfort (Premium Economy), and CloudElite (Business Class) fares on all domestic and international CloudWay 24-operated flights.",
                    "depth": 0
                  },
                  {
                    "text": "Complimentary Additional 10kg Baggage Allowance on all tickets booked under this scheme.",
                    "depth": 0
                  },
                  {
                    "text": "Priority Check-in and Boarding Privileges at all major hubs.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "👩‍✈️ Who is Eligible?",
            "level": 2,
            "location": {
              "line": 16,
              "heading": "CloudWay 24 | Armed Forces Discount Program"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 18,
                  "heading": "👩‍✈️ Who is Eligible?"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Serving Personnel of the Indian Army, Navy, Air Force, Coast Guard, and Paramilitary Forces.",
                    "depth": 0
                  },
                  {
                    "text": "Retired/ Ex-Servicemen of the above services.",
                    "depth": 0
                  },
                  {
                    "text": "Immediate Family Members(spouse and dependent children) when traveling with the eligible personnel.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "📝 How to Avail:",
            "level": 2,
            "location": {
              "line": 24,
              "heading": "CloudWay 24 | Armed Forces Discount Program"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 26,
                  "heading": "📝 How to Avail:"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Sign Up / Login with your email or mobile on CloudWay24.com (https://CloudWay24.com) or the CloudWay24 App (iOS/Android).",
                    "depth": 0
                  },
                  {
                    "text": "Select “Plan My Flight” and enter your round trip or one-way details.",
                    "depth": 0
                  },
                  {
                    "text": "On the passenger details page, choose “Armed Forces Discount” and upload valid service/retirement ID proof.",
                    "depth": 0
                  },
                  {
                    "text": "Proceed to payment — discounted fare and baggage benefits will be automatically applied.",
                    "depth": 0
                  },
                  {
                    "text": "Complete booking using credit/debit card, netbanking, or SkyPoints 24 points.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "📄 Acceptable ID Proofs",
            "level": 2,
            "location": {
              "line": 34,
              "heading": "CloudWay 24 | Armed Forces Discount Program"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 36,
                  "heading": "📄 Acceptable ID Proofs"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Government-issued Armed Forces Service Card (for serving personnel)",
                    "depth": 0
                  },
                  {
                    "text": "Pension Payment Order/ Ex-Serviceman Identity Card/ Retirement Card (for retired personnel)",
                    "depth": 0
                  },
                  {
                    "text": "Dependent ID Card (for family members)",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Terms & Conditions",
            "level": 2,
            "location": {
              "line": 42,
              "heading": "CloudWay 24 | Armed Forces Discount Program"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 44,
                  "heading": "Terms & Conditions"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "The armed forces discount is subject to seat availability under the applicable fare class.",
                    "depth": 0
                  },
                  {
                    "text": "Discount is applicable only on base fare, not including taxes, surcharges or add-ons.",
                    "depth": 0
                  },
                  {
                    "text": "Not combinable with other promotional offers.",
                    "depth": 0
                  },
                  {
                    "text": "Valid ID proof must be carried and shown at check-in/counters.",
                    "depth": 0
                  },
                  {
                    "text": "CloudWay 24 reserves the right to withdraw or modify the offer at any time.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 52,
                  "heading": "Terms & Conditions"
                },
                "text": "Seamless Skies, Global Reach.\nDiscover the world with respect—and savings."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 55,
                  "heading": "Terms & Conditions"
                },
