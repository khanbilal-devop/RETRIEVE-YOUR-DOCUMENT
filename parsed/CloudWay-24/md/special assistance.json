            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 9,
                  "heading": "How to Request Special Assistance"
                },
                "text": "You can request special assistance:"
              },
              {
                "type": "list",
                "location": {
                  "line": 10,
                  "heading": "How to Request Special Assistance"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "During the booking process on CloudWay24.com or the CloudWay24 mobile app",
                    "depth": 0
                  },
                  {
                    "text": "By contacting our Customer Service Team via email or phone",
                    "depth": 0
                  },
                  {
                    "text": "At the airport check-in counter prior to your flight",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 14,
                  "heading": "How to Request Special Assistance"
                },
                "text": "Note: For the best experience, please inform us at least 48 hours before departure."
