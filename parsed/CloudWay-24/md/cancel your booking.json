          {
            "title": "Refund & Cancellation Policy",
            "level": 2,
            "location": {
              "line": 33,
              "heading": "Cancel Your Booking with CloudWay 24"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 35,
                  "heading": "Refund & Cancellation Policy"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Refund eligibility: Depends on fare type, class of travel, and time of cancellation.",
                    "depth": 0
                  },
                  {
                    "text": "Flexible tickets: Eligible for full or partial refund, as per fare conditions.",
                    "depth": 0
                  },
                  {
                    "text": "Promotional or non-refundable fares: Generally non-refundable except for taxes, as per policy.",
                    "depth": 0
                  },
                  {
                    "text": "Refund method: Processed to the original payment method (credit/debit card, netbanking, or SkyPoints 24 points).",
                    "depth": 0
                  },
                  {
                    "text": "Processing time: Refunds are typically processed within 7–10 business days.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": [
              {
                "title": "Note:",
                "level": 3,
                "location": {
                  "line": 41,
                  "heading": "Refund & Cancellation Policy"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 42,
                      "heading": "Note:"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Cancellation fees may apply based on fare class and timing.",
                        "depth": 0
                      },
                      {
                        "text": "No-shows or last-minute cancellations may receive reduced refunds.",
                        "depth": 0
                      },
                      {
                        "text": "For third-party/travel agent bookings, please contact the respective agent for cancellation.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
