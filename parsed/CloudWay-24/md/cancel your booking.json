                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Visit CloudWay24.com (https://cloudway24.com).",
                        "depth": 0
                      },
                      {
                        "text": "Sign in with your email or mobile number.",
                        "depth": 0
                      },
                      {
                        "text": "Navigate to Manage My Flight.",
                        "depth": 0
                      },
                      {
                        "text": "Select Cancel Your Booking.",
                        "depth": 0
                      },
                      {
                        "text": "Enter your booking details (Booking reference and Last name).",
