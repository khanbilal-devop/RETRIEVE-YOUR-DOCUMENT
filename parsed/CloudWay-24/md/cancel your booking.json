                  "heading": "How to Cancel Your Booking"
                },
                "text": "You can cancel your booking in two convenient ways:"
              }
            ],
            "sections": [
              {
                "title": "1. Website",
                "level": 3,
                "location": {
                  "line": 11,
                  "heading": "How to Cancel Your Booking"
                },
                "blocks": [
                  {
                    "type": "list",
