            "sections": [
              {
                "title": "1. Self-Registration (Online)",
                "level": 3,
                "location": {
                  "line": 20,
                  "heading": "How to Activate ZX Bank NetBanking"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 21,
                      "heading": "1. Self-Registration (Online)"
                    },
                    "ordered": true,
                    "items": [
                      {
                        "text": "Visit ZX Bank Asia Website (https://www.zxbank.asia)",
                        "depth": 0
                      },
                      {
                        "text": "Click on ‘NetBanking Login’ and select ‘New User/Register’",
                        "depth": 0
                      },
                      {
                        "text": "Enter:",
                        "depth": 0
                      },
                      {
                        "text": "Customer ID (from passbook/account statement)",
                        "depth": 1
                      },
                      {
                        "text": "Registered mobile number",
                        "depth": 1
                      },
                      {
                        "text": "Verification via OTP",
                        "depth": 1
                      },
                      {
                        "text": "Set your NetBanking username and password.",
                        "depth": 0
                      },
                      {
                        "text": "Login and set transactional password & security questions.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "2. Activation via Branch",
                "level": 3,
                "location": {
                  "line": 30,
                  "heading": "How to Activate ZX Bank NetBanking"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 31,
                      "heading": "2. Activation via Branch"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Visit any ZX Bank branch.",
                        "depth": 0
                      },
                      {
                        "text": "Fill NetBanking registration form.",
                        "depth": 0
                      },
                      {
                        "text": "Receive welcome kit/activation link on mobile/email.",
                        "depth": 0
                      },
                      {
                        "text": "Set your login and transaction password.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "3. Activation via Mobile App",
                "level": 3,
                "location": {
                  "line": 36,
                  "heading": "How to Activate ZX Bank NetBanking"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 37,
                      "heading": "3. Activation via Mobile App"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Download the ZX Bank Asia app (Android/iOS).",
                        "depth": 0
                      },
                      {
                        "text": "Select ‘Register for NetBanking’.",
                        "depth": 0
                      },
                      {
                        "text": "Follow in-app instructions (similar to online self-registration).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
