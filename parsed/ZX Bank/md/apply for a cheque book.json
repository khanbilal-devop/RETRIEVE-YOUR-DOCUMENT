                    "items": [
                      {
                        "text": "Delivery Time: Cheque books are dispatched within 3–7 working days.",
                        "depth": 0
                      },
                      {
                        "text": "Charges: The first cheque book of the year is usually free. Subsequent requests may incur standard charges.",
                        "depth": 0
                      },
                      {
                        "text": "Track Status: Use the mobile app or NetBanking to check dispatch and delivery status.",
                        "depth": 0
                      },
                      {
                        "text": "Change Address: Update your address before placing the request to ensure correct delivery.",
                        "depth": 0
                      }
