        "title": "How to Apply for a Cheque Book at ZX Bank",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "How to Apply for a Cheque Book at ZX Bank"
            },
            "text": "Applying for a cheque book from ZX Bank is simple and can be done through multiple convenient channels. Follow the steps below to request your new cheque book."
          }
        ],
        "sections": [
          {
            "title": "1. Via ZX Bank Mobile App",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "How to Apply for a Cheque Book at ZX Bank"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 9,
                  "heading": "1. Via ZX Bank Mobile App"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Login: Open the ZX Bank Asia app and log in using your credentials or biometric authentication.",
                    "depth": 0
                  },
                  {
                    "text": "Navigate: Go to Services or Request Services on the home menu.",
                    "depth": 0
                  },
                  {
                    "text": "Select: Tap on Cheque Book Request.",
                    "depth": 0
                  },
                  {
                    "text": "Choose Account: Select the account for which you need the cheque book.",
                    "depth": 0
                  },
                  {
                    "text": "Confirm Details: Enter delivery address (if different from registered address).",
                    "depth": 0
                  },
                  {
                    "text": "Submit: Review and submit your request.\nYou’ll receive a confirmation SMS/email with the estimated delivery time.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "2. Through NetBanking",
            "level": 2,
            "location": {
              "line": 19,
              "heading": "How to Apply for a Cheque Book at ZX Bank"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 21,
                  "heading": "2. Through NetBanking"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Log in to ZX Bank NetBanking (https://www.zxbank.asia).",
                    "depth": 0
                  },
                  {
                    "text": "Go to Services > Cheque Book Request.",
                    "depth": 0
                  },
                  {
                    "text": "Select your account and number of leaves required.",
                    "depth": 0
                  },
                  {
                    "text": "Verify your address and submit the request.",
                    "depth": 0
                  },
                  {
                    "text": "Track status online under Request History.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "3. At Branch",
            "level": 2,
            "location": {
              "line": 29,
              "heading": "How to Apply for a Cheque Book at ZX Bank"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 31,
                  "heading": "3. At Branch"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Visit your nearest ZX Bank branch.",
                    "depth": 0
                  },
                  {
                    "text": "Fill out the Cheque Book Request Form at the counter.",
                    "depth": 0
                  },
                  {
                    "text": "Submit it to the bank officer along with valid ID, if required.",
                    "depth": 0
                  },
                  {
                    "text": "Collect acknowledgment receipt with expected dispatch date.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "4. Via ZX Bank ATM",
            "level": 2,
            "location": {
              "line": 38,
              "heading": "How to Apply for a Cheque Book at ZX Bank"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 40,
                  "heading": "4. Via ZX Bank ATM"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Insert your ZX Bank debit card and enter your PIN.",
                    "depth": 0
                  },
                  {
                    "text": "Go to Services > Cheque Book Request.",
                    "depth": 0
                  },
                  {
                    "text": "Select account and number of leaves.",
                    "depth": 0
                  },
                  {
                    "text": "Confirm the request to complete the process.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
