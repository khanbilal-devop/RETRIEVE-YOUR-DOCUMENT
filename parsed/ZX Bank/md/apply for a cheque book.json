                },
                "ordered": false,
                "items": [
                  {
                    "text": "Call ZX Bank’s 24x7 helpline: 1800-XXX-XXXX (toll-free in India)",
                    "depth": 0
                  },
                  {
                    "text": "Verify your details with the customer care executive.",
                    "depth": 0
                  },
                  {
                    "text": "Place your cheque book request and note down the reference number.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": [
              {
