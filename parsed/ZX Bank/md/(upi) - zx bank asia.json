                  "heading": "💡 What is UPI?"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Instant, 24x7 money transfers via mobile devices",
                    "depth": 0
                  },
                  {
                    "text": "Single app for accessing multiple bank accounts",
                    "depth": 0
                  },
                  {
                    "text": "Easy transactions using mobile number, Virtual Payment Address (VPA), or QR codes",
                    "depth": 0
                  },
                  {
                    "text": "Used for: Fund transfer, bill payments, merchant payments, and more",
                    "depth": 0
                  }
                ]
