    "sections": [
      {
        "title": "Health Insurance",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "Health Insurance"
            },
            "text": "Health insurance is a type of insurance coverage that pays for medical and surgical expenses incurred by the insured. It is designed to protect individuals and families from high healthcare costs and offer access to quality medical services."
          }
        ],
        "sections": [
          {
            "title": "Key Features",
            "level": 2,
            "location": {
              "line": 5,
              "heading": "Health Insurance"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 7,
                  "heading": "Key Features"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Coverage for Medical Expenses: Includes hospitalization, surgeries, outpatient care, prescription drugs, diagnostics, and preventive services.",
                    "depth": 0
                  },
                  {
                    "text": "Cashless Treatment: Many insurers offer cashless claim settlement at network hospitals, eliminating upfront payments by the policyholder.",
                    "depth": 0
                  },
                  {
                    "text": "Pre- and Post-Hospitalization: Expenses incurred before and after hospitalization are often covered.",
                    "depth": 0
                  },
                  {
                    "text": "Family Floater Plans: A single policy that covers the entire family under one sum insured.",
                    "depth": 0
                  },
                  {
                    "text": "Optional Add-ons: Critical illness cover, maternity benefits, accidental benefits, and top-ups for enhanced protection.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Types of Health Insurance",
            "level": 2,
            "location": {
              "line": 13,
              "heading": "Health Insurance"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 15,
                  "heading": "Types of Health Insurance"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Individual Health Insurance: Covers a single person.",
                    "depth": 0
                  },
                  {
                    "text": "Family Floater Health Insurance: Covers the entire family under one policy.",
                    "depth": 0
                  },
                  {
                    "text": "Senior Citizen Health Insurance: Customized for individuals above a certain age (typically 60+).",
                    "depth": 0
                  },
                  {
                    "text": "Critical Illness Insurance: Lump sum payout on diagnosis of specific illnesses like cancer, heart attack, etc.",
                    "depth": 0
                  },
                  {
                    "text": "Group Health Insurance: Provided by employers for their employees.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Benefits",
            "level": 2,
            "location": {
              "line": 21,
              "heading": "Health Insurance"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 23,
                  "heading": "Benefits"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Financial Protection: Shields against expensive medical treatments.",
                    "depth": 0
                  },
                  {
                    "text": "Access to Quality Healthcare: Facilitates timely and quality healthcare services.",
                    "depth": 0
                  },
                  {
                    "text": "Tax Benefits: Premiums paid are eligible for tax deductions (e.g., under Section 80D in India).",
                    "depth": 0
                  },
                  {
                    "text": "Peace of Mind: Reduces the stress of unexpected medical emergencies.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
