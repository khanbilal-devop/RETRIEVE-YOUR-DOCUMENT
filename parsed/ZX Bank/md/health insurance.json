          {
            "title": "How to Choose a Health Insurance Plan",
            "level": 2,
            "location": {
              "line": 39,
              "heading": "Health Insurance"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 41,
                  "heading": "How to Choose a Health Insurance Plan"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Assess Your Needs: Consider age, family size, health conditions.",
                    "depth": 0
                  },
                  {
                    "text": "Compare Plans: Look for coverage, exclusions, claim process, and premium.",
                    "depth": 0
                  },
                  {
                    "text": "Check Network Hospitals: Wide network ensures better access.",
                    "depth": 0
                  },
                  {
                    "text": "Understand Exclusions: Know what isn’t covered.",
                    "depth": 0
                  },
                  {
                    "text": "Look for Add-ons: Customize the policy for better protection.",
                    "depth": 0
                  },
                  {
                    "text": "Review Claim Settlement Ratio: Indicates reliability of insurer.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Common Exclusions",
            "level": 2,
            "location": {
              "line": 48,
              "heading": "Health Insurance"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 50,
                  "heading": "Common Exclusions"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Pre-existing diseases (during waiting period)",
                    "depth": 0
                  },
                  {
                    "text": "Cosmetic treatments",
                    "depth": 0
                  },
                  {
                    "text": "Dental and vision (unless specified)",
                    "depth": 0
                  },
                  {
                    "text": "Self-inflicted injuries",
                    "depth": 0
                  },
                  {
                    "text": "Non-allopathic treatments",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Frequently Asked Questions",
            "level": 2,
            "location": {
              "line": 56,
              "heading": "Health Insurance"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 58,
                  "heading": "Frequently Asked Questions"
                },
                "text": "Q: Is health insurance mandatory?\nA: Not in most countries, but highly recommended due to rising healthcare costs."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 61,
                  "heading": "Frequently Asked Questions"
                },
                "text": "Q: What happens if a claim is denied?\nA: Review the reason, appeal to the insurer, or approach a regulatory authority."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 64,
                  "heading": "Frequently Asked Questions"
                },
                "text": "Q: Can I port my health policy to another insurer?\nA: Yes, most countries allow portability after certain conditions are met."
              }
            ],
