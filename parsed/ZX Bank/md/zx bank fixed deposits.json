        "title": "ZX Bank Fixed Deposits",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "ZX Bank Fixed Deposits"
            },
            "text": "ZX Bank offers attractive and secure Fixed Deposit (FD) solutions tailored for individuals, businesses, and Non-Resident Indians (NRIs) across its operating countries. With ZX Bank's robust digital services and reliable branch presence, customers can enjoy seamless booking, management, and maturity payouts of fixed deposits."
          }
        ],
        "sections": [
          {
            "title": "Why Choose ZX Bank Fixed Deposits?",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "ZX Bank Fixed Deposits"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 9,
                  "heading": "Why Choose ZX Bank Fixed Deposits?"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Competitive Interest Rates: Enjoy higher returns compared to regular savings accounts.",
                    "depth": 0
                  },
                  {
                    "text": "Flexible Tenures: Tenure options ranging from 7 days to 10 years.",
                    "depth": 0
                  },
                  {
                    "text": "Safe & Secure: Backed by ZX Bank’s sound financial position and regulatory compliance.",
                    "depth": 0
                  },
                  {
                    "text": "Loan Against FD: Avail instant overdraft or loans up to 90% of your FD value.",
                    "depth": 0
                  },
                  {
                    "text": "Premature Withdrawal: Facility available (premature closure charges may apply).",
                    "depth": 0
                  },
                  {
                    "text": "Digital Opening: Open, renew, or close FDs instantly through ZX Bank Asia mobile app or NetBanking.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Features & Benefits",
            "level": 2,
            "location": {
              "line": 18,
              "heading": "ZX Bank Fixed Deposits"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 20,
                  "heading": "Features & Benefits"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Minimum Deposit: ₹5,000 (India), LKR 10,000 (Sri Lanka), BDT 10,000 (Bangladesh), BTN 1,000 (Bhutan), NPR 1,500 (Nepal)",
                    "depth": 0
                  },
                  {
                    "text": "Interest Payout: Choose from monthly, quarterly, or on maturity payout options",
                    "depth": 0
                  },
                  {
                    "text": "Special Schemes: Senior citizen extra interest, tax-saver FDs, recurring deposit variants",
                    "depth": 0
                  },
                  {
                    "text": "Joint Deposits: Facility for joint holding and nomination",
                    "depth": 0
                  },
                  {
                    "text": "Auto-renewal: Hassle-free renewal option available",
                    "depth": 0
                  }
                ]
              }
            ],
