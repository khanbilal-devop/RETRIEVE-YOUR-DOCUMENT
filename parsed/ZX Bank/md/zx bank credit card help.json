        "title": "How to Close Your ZX Bank Credit Card",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "text": "Closing your ZX Bank Credit Card is a straightforward process. Follow the steps below to ensure a smooth and secure closure:"
          }
        ],
        "sections": [
          {
            "title": "1. Clear Outstanding Dues",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 8,
                  "heading": "1. Clear Outstanding Dues"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Pay Off All Dues: Settle any outstanding amounts (balances, fees, charges, or EMI on the card).",
                    "depth": 0
                  },
                  {
                    "text": "Download Statements: Keep a record of your final statement for future reference.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "2. Redeem Unused Rewards",
            "level": 2,
            "location": {
              "line": 13,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 14,
                  "heading": "2. Redeem Unused Rewards"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Check for Points: Redeem all reward points, cashback, or benefits, as they will be lost after closure.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "3. Cancel Auto-debits & Linked Payments",
            "level": 2,
            "location": {
              "line": 18,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 19,
                  "heading": "3. Cancel Auto-debits & Linked Payments"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Deactivate: Cancel standing instructions, auto-debits, or subscriptions linked to your card.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "4. Request Card Closure",
            "level": 2,
            "location": {
              "line": 23,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 24,
                  "heading": "4. Request Card Closure"
                },
                "text": "You can place a closure request using any of the following channels:"
              }
            ],
            "sections": [
              {
                "title": "a. Via ZX Bank Mobile App (\"ZX Bank Asia\")",
                "level": 3,
                "location": {
                  "line": 26,
                  "heading": "4. Request Card Closure"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 27,
                      "heading": "a. Via ZX Bank Mobile App (\"ZX Bank Asia\")"
                    },
                    "ordered": true,
                    "items": [
                      {
                        "text": "Login to the app.",
                        "depth": 0
                      },
                      {
                        "text": "Go to Card Services > Credit Card Closure.",
                        "depth": 0
                      },
                      {
                        "text": "Select your card and follow the on-screen prompts.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "b. Through ZX NetBanking",
                "level": 3,
                "location": {
                  "line": 31,
                  "heading": "4. Request Card Closure"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 32,
                      "heading": "b. Through ZX NetBanking"
                    },
                    "ordered": true,
                    "items": [
                      {
                        "text": "Login to ZX NetBanking.",
                        "depth": 0
                      },
                      {
                        "text": "Navigate to Cards > Credit Cards > Close Credit Card.",
                        "depth": 0
                      },
                      {
                        "text": "Select your credit card and confirm your request.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "c. Customer Care",
                "level": 3,
                "location": {
                  "line": 36,
                  "heading": "4. Request Card Closure"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 37,
                      "heading": "c. Customer Care"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Call 24x7 helpline:",
                        "depth": 0
                      },
                      {
                        "text": "India: 1800-123-4567",
                        "depth": 1
                      },
                      {
                        "text": "Sri Lanka: 011-2345678",
                        "depth": 1
                      },
                      {
                        "text": "Bangladesh: 0961-234567",
                        "depth": 1
                      },
                      {
                        "text": "Request card closure with your card details handy.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "d. Branch Visit",
                "level": 3,
                "location": {
                  "line": 43,
                  "heading": "4. Request Card Closure"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 44,
                      "heading": "d. Branch Visit"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Visit your nearest ZX Bank branch.",
                        "depth": 0
                      },
                      {
                        "text": "Submit a written request or fill out a card closure form.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "5. Destroy the Card",
            "level": 2,
            "location": {
              "line": 49,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 50,
                  "heading": "5. Destroy the Card"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "After confirmation, cut your card (including chip and magnetic strip) and dispose of it securely.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "6. Obtain Closure Confirmation",
            "level": 2,
            "location": {
              "line": 54,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 55,
                  "heading": "6. Obtain Closure Confirmation"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Closure Letter/Email: ZX Bank will send a closure confirmation within 7 working days.",
                    "depth": 0
                  },
                  {
                    "text": "Check CIBIL/Credit Report: Ensure the card appears as ‘closed’ (not ‘settled’).",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "#### Important Notes",
            "level": 2,
            "location": {
              "line": 60,
              "heading": "How to Close Your ZX Bank Credit Card"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 61,
                  "heading": "#### Important Notes"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Closing a credit card may affect your credit score.",
                    "depth": 0
                  },
                  {
                    "text": "You cannot re-activate a closed card; a new application is required.",
                    "depth": 0
                  },
                  {
                    "text": "If you see continuing charges post-closure, inform ZX Bank immediately.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 65,
                  "heading": "#### Important Notes"
                },
                "text": "For help, contact ZX Bank Customer Care via the ZX Bank Asia mobile app or visit www.zxbank.asia (http://www.zxbank.asia)."
              }
            ],
            "sections": []
          }
        ]
      }
