    "sections": [
      {
        "title": "Best Ways to Use Your Car AC in All Seasons",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 2,
              "heading": "Best Ways to Use Your Car AC in All Seasons"
            },
            "text": "For Aventro Motors Car Owners"
          }
        ],
        "sections": []
      },
      {
        "title": null,
        "level": 1,
        "location": {
          "line": 4
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 6
            },
            "text": "Your vehicle’s air conditioning (AC) system is vital for comfort and safety throughout the year. Whether it’s cooling in summer, defogging in monsoon, or maintaining a pleasant environment in winter, knowing how to use the AC efficiently will extend system life and enhance your driving experience. Here’s a guide to making the most of your AC system during every season."
          }
        ],
        "sections": [
          {
            "title": "Summer: Beat the Heat",
            "level": 2,
            "location": {
              "line": 10
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 12,
                  "heading": "Summer: Beat the Heat"
                },
                "text": "1. Ventilate First"
              },
              {
                "type": "list",
                "location": {
                  "line": 13,
                  "heading": "Summer: Beat the Heat"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Before switching on the AC, roll down the windows and drive for a couple of minutes to expel hot air.",
                    "depth": 0
                  },
                  {
                    "text": "This makes the cabin cool down faster.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 16,
                  "heading": "Summer: Beat the Heat"
                },
                "text": "2. Use Recirculation Mode"
              },
              {
                "type": "list",
                "location": {
                  "line": 17,
                  "heading": "Summer: Beat the Heat"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Turn on the AC and set it to “recirculate” once the cabin is cool.",
                    "depth": 0
                  },
                  {
                    "text": "This prevents hot outside air from entering, making the system more effective.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 20,
                  "heading": "Summer: Beat the Heat"
                },
                "text": "3. Set the Right Temperature"
              },
              {
                "type": "list",
                "location": {
                  "line": 21,
                  "heading": "Summer: Beat the Heat"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Avoid setting the thermostat to the lowest setting. 22-24°C (72-75°F) is usually comfortable and easier on the compressor.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 23,
                  "heading": "Summer: Beat the Heat"
                },
                "text": "4. Regular Maintenance"
              },
              {
                "type": "list",
                "location": {
                  "line": 24,
                  "heading": "Summer: Beat the Heat"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Clean or replace the cabin air filter.",
                    "depth": 0
                  },
                  {
                    "text": "Get your AC system inspected and refrigerant topped up at an Aventro Service Center before summer starts.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Monsoon: Fight Humidity and Fog",
            "level": 2,
            "location": {
              "line": 29
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 31,
                  "heading": "Monsoon: Fight Humidity and Fog"
                },
                "text": "1. Use AC for Defogging"
              },
              {
                "type": "list",
                "location": {
                  "line": 32,
                  "heading": "Monsoon: Fight Humidity and Fog"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Turn on the AC with the blower directed at the windshield to quickly clear fog.",
                    "depth": 0
                  },
                  {
                    "text": "Use the “fresh air” mode for a few minutes to reduce internal humidity.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 35,
                  "heading": "Monsoon: Fight Humidity and Fog"
                },
                "text": "2. Don’t Use Recirculate Mode Continuously"
              },
              {
                "type": "list",
                "location": {
                  "line": 36,
                  "heading": "Monsoon: Fight Humidity and Fog"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Constant recirculation during rains may increase humidity inside, causing more fogging.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 38,
                  "heading": "Monsoon: Fight Humidity and Fog"
                },
                "text": "3. Keep Windows Closed"
              },
              {
                "type": "list",
                "location": {
                  "line": 39,
                  "heading": "Monsoon: Fight Humidity and Fog"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Prevent water and more humidity from entering the cabin.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Winter: Comfort with Care",
            "level": 2,
            "location": {
              "line": 43
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 45,
                  "heading": "Winter: Comfort with Care"
                },
                "text": "1. Run the AC Regularly"
              },
              {
                "type": "list",
                "location": {
                  "line": 46,
                  "heading": "Winter: Comfort with Care"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Turn on the AC for at least 10 minutes once a week, even in winter.",
                    "depth": 0
                  },
                  {
                    "text": "This keeps seals lubricated and prevents mold in the system.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 49,
                  "heading": "Winter: Comfort with Care"
                },
                "text": "2. Use AC with Heater for Defogging"
              },
              {
                "type": "list",
                "location": {
                  "line": 50,
                  "heading": "Winter: Comfort with Care"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Warm air alone may not clear the windshield.",
                    "depth": 0
                  },
                  {
                    "text": "Use the AC and heater together (AC dries the air, heater warms it) for effective demisting.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "General Tips for All Seasons",
            "level": 2,
            "location": {
              "line": 55
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 57,
                  "heading": "General Tips for All Seasons"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Service Regularly: Schedule professional AC checks at Aventro Service Centers.",
                    "depth": 0
                  },
                  {
                    "text": "Check for Odors: Foul smells may indicate mold – get the filters and system checked.",
                    "depth": 0
                  },
                  {
                    "text": "Avoid Overloading: Don’t overload your car; heavy loads reduce AC efficiency.",
                    "depth": 0
                  },
                  {
                    "text": "Park in Shade: Protect your car from direct sun to reduce AC workload.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "When to Seek Professional Help",
            "level": 2,
            "location": {
              "line": 64
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 66,
                  "heading": "When to Seek Professional Help"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "AC not cooling/heating as expected",
                    "depth": 0
                  },
                  {
                    "text": "Unusual noises/smells from the vents",
                    "depth": 0
                  },
                  {
                    "text": "Visible leaks under your car",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 70,
                  "heading": "When to Seek Professional Help"
                },
                "text": "Visit your nearest Aventro Service Center for expert AC service and diagnostics."
              }
            ],
            "sections": []
          },
          {
            "title": null,
            "level": 2,
            "location": {
              "line": 72
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 74
                },
                "text": "Stay comfortable, healthy, and safe in every season with these smart AC usage tips!"
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 76
                },
                "text": "For more information or to book an AC service, contact Aventro Motors at info@aventromotors.com (mailto:info@aventromotors.com) or visit your nearest Aventro Service Center."
              }
            ],
            "sections": []
          }
        ]
      }
    ]
  }
