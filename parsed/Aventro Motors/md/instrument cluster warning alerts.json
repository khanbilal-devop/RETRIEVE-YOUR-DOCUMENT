              {
                "type": "list",
                "location": {
                  "line": 76,
                  "heading": "Important Notes"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "If any red warning light appears, stop the vehicle in a safe location as soon as possible and consult your Aventro Motors dealer or the owner's manual.",
                    "depth": 0
                  },
                  {
                    "text": "Yellow/amber lights indicate caution; check the system soon.",
                    "depth": 0
                  },
                  {
                    "text": "For hybrid/electric models, specific alerts will provide system details regarding battery, charging, and electric drive functions.",
                    "depth": 0
                  }
                ]
              }
