                  "heading": "7. Coolant Temperature Warning Light"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Meaning: Engine is overheating. Stop the vehicle in a safe place and check coolant levels.",
                    "depth": 0
                  }
                ]
              }
