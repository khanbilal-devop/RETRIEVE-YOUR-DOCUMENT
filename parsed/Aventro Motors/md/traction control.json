            "blocks": [],
            "sections": [
              {
                "title": "Can I switch off traction control?",
                "level": 3,
                "location": {
                  "line": 85,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 86,
                      "heading": "Can I switch off traction control?"
                    },
                    "text": "Some models offer the ability to temporarily disable traction control, useful in specific situations like getting a stuck vehicle moving. Refer to your Aventro Motors owner’s manual for guidance."
                  }
                ],
                "sections": []
              },
              {
                "title": "Does traction control replace winter tires?",
                "level": 3,
                "location": {
                  "line": 88,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 89,
                      "heading": "Does traction control replace winter tires?"
                    },
                    "text": "No, traction control assists traction, but does not substitute proper tire selection for icy or snowy conditions."
                  }
                ],
                "sections": []
              },
