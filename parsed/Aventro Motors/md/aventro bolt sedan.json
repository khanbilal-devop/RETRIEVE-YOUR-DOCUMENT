                "location": {
                  "line": 84,
                  "heading": "Why Choose Bolt Sedan?"
                },
                "text": "Aventro Bolt Sedan is designed for buyers seeking a blend of performance, advanced technology, comfort, and safety—all at an accessible price point."
              },
              {
                "type": "list",
                "location": {
                  "line": 86,
                  "heading": "Why Choose Bolt Sedan?"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Performance: Available with best-in-segment petrol, diesel, electric, and hybrid engines.",
                    "depth": 0
                  },
                  {
                    "text": "Technology: State-of-the-art infotainment and safety features with ADAS.",
                    "depth": 0
                  },
                  {
                    "text": "Luxury: Top trims offer leather seats, premium audio, and connected technology.",
                    "depth": 0
                  },
                  {
                    "text": "Value: Feature-rich across all variants.",
                    "depth": 0
                  }
                ]
              },
