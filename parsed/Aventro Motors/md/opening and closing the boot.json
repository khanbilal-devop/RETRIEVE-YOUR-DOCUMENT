          "line": 1
        },
        "blocks": [],
        "sections": [
          {
            "title": "Opening the Boot",
            "level": 2,
            "location": {
              "line": 3,
              "heading": "Opening and Closing the Boot"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 5,
                  "heading": "Opening the Boot"
                },
                "text": "There are several ways you can open the boot (trunk) of your Aventro vehicle, depending on the model and features equipped:"
              }
            ],
            "sections": [
              {
                "title": "1. Manual Release (Lever/Button)",
                "level": 3,
                "location": {
                  "line": 7,
                  "heading": "Opening the Boot"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 8,
                      "heading": "1. Manual Release (Lever/Button)"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Locate the boot release lever or button inside the vehicle.",
                        "depth": 0
                      },
                      {
                        "text": "Usually found near the driver’s seat or on the driver’s side door panel.",
                        "depth": 1
                      },
                      {
                        "text": "Pull the lever or press the button.",
                        "depth": 0
                      },
                      {
                        "text": "You’ll hear a click indicating the boot is unlocked.",
                        "depth": 1
                      },
                      {
                        "text": "Go to the rear of the vehicle and lift the boot lid upwards to open.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "2. Remote Key Fob",
                "level": 3,
                "location": {
                  "line": 14,
                  "heading": "Opening the Boot"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 15,
                      "heading": "2. Remote Key Fob"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Press and hold the boot release button on your vehicle’s remote key fob.",
                        "depth": 0
                      },
                      {
                        "text": "The boot will unlock and, on some models, may open slightly for you to lift.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "3. Exterior Button or Handle",
                "level": 3,
                "location": {
                  "line": 18,
                  "heading": "Opening the Boot"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 19,
                      "heading": "3. Exterior Button or Handle"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "With the vehicle unlocked, press the soft-touch button or lift the handle located just above the number plate or under the boot lid.",
                        "depth": 0
                      },
                      {
                        "text": "Lift the boot gently to open.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "4. Hands-Free Option (If Equipped)",
                "level": 3,
                "location": {
                  "line": 22,
                  "heading": "Opening the Boot"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 23,
                      "heading": "4. Hands-Free Option (If Equipped)"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "With the key fob in your possession, stand behind the boot and make a gentle kicking motion under the center of the rear bumper (sensor area).",
                        "depth": 0
                      },
                      {
                        "text": "Wait for a few seconds; the boot will unlatch automatically. Lift to open.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "Closing the Boot",
            "level": 2,
            "location": {
              "line": 28,
              "heading": "Opening and Closing the Boot"
            },
            "blocks": [],
            "sections": [
              {
                "title": "1. Manual Closing",
                "level": 3,
                "location": {
                  "line": 30,
                  "heading": "Closing the Boot"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 31,
                      "heading": "1. Manual Closing"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Grip the inner handle or any designated area on the inside of the boot lid.",
                        "depth": 0
                      },
                      {
                        "text": "Pull the boot lid down smoothly and press gently until you hear it latch.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "2. Electrically Assisted/Tailgate Models (If Equipped)",
                "level": 3,
                "location": {
                  "line": 34,
                  "heading": "Closing the Boot"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 35,
                      "heading": "2. Electrically Assisted/Tailgate Models (If Equipped)"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Press the boot’s close button (located on the edge of the boot lid).",
                        "depth": 0
                      },
                      {
                        "text": "The lid will automatically close and latch securely.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "3. Cautions When Closing",
                "level": 3,
                "location": {
                  "line": 38,
                  "heading": "Closing the Boot"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 39,
                      "heading": "3. Cautions When Closing"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Make sure there are no obstructions or luggage sticking out.",
                        "depth": 0
                      },
                      {
                        "text": "Ensure all hands and fingers are away from the boot area before closing.",
                        "depth": 0
                      },
                      {
                        "text": "Do not slam the boot lid; close it with a gentle but firm push.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": null,
                "level": 3,
                "location": {
                  "line": 43,
                  "heading": "Closing the Boot"
                },
                "blocks": [
                  {
                    "type": "quote",
                    "location": {
                      "line": 45
                    },
                    "text": "Note:\nIf the boot does not open or close properly, check if the vehicle is in ‘Valet Mode’ or if the child safety lock for the boot is engaged. For electrically operated boots, ensure the battery has sufficient charge."
                  }
                ],
                "sections": []
              }
            ]
          },
