                "items": [
                  {
                    "text": "Net Zero Manufacturing by 2028\nFully transition to renewable energy in all manufacturing sites globally.",
                    "depth": 0
                  },
                  {
                    "text": "Circular Design Commitment\nLaunch modular smartphones and tablets with user-replaceable parts by 2026.",
                    "depth": 0
                  },
                  {
                    "text": "Certified Carbon Offset Program\nOffer opt-in offsets for all online purchases, contributing to reforestation and clean energy projects.",
                    "depth": 0
                  }
