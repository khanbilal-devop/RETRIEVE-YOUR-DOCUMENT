          {
            "title": "Privacy & Data Security",
            "level": 3,
            "location": {
              "line": 24,
              "heading": "Important Notes & Terms"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 26,
                  "heading": "Privacy & Data Security"
                },
                "text": "Velvera is committed to safeguarding your digital rights, privacy, and data through a privacy-first design philosophy embedded in all our products and services."
              }
            ],
            "sections": [
              {
                "title": "Security Highlights",
                "level": 4,
                "location": {
                  "line": 28,
                  "heading": "Privacy & Data Security"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 30,
                      "heading": "Security Highlights"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Hardware-Level Encryption:\nAll Velvera devices include secure enclaves and tamper-proof encryption modules.",
                        "depth": 0
                      },
                      {
                        "text": "Local Data Processing:\nAI features like voice processing, photo indexing, and suggestions are executed on-device by default, reducing unnecessary data transmission to cloud servers.",
                        "depth": 0
                      },
                      {
                        "text": "Privacy Controls:",
                        "depth": 0
                      },
                      {
                        "text": "VelveraOS provides a granular privacy dashboard to control app permissions, background activity, and data access logs.",
                        "depth": 1
                      },
                      {
                        "text": "Mic/Camera indicators and hardware kill-switch options (Nexus series) enhance user control.",
                        "depth": 1
                      },
                      {
                        "text": "Data Compliance:",
                        "depth": 0
                      },
                      {
                        "text": "Fully GDPR, India PDP Act, and California Consumer Privacy Act (CCPA) compliant.",
                        "depth": 1
                      },
                      {
                        "text": "Annual third-party audits and white-hat bug bounty programs ensure continuous hardening.",
                        "depth": 1
                      },
                      {
                        "text": "No Ad Tracking Policy:",
                        "depth": 0
                      },
                      {
                        "text": "Velvera does not monetize user data or permit third-party behavioral ads across its ecosystem.",
                        "depth": 1
                      },
                      {
                        "text": "Anonymous telemetry (if enabled) is used solely for performance improvement.",
                        "depth": 1
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
