            "sections": [
              {
                "title": "1. Unboxing and Setup",
                "level": 3,
                "location": {
                  "line": 5,
                  "heading": "Getting Started"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 6,
                      "heading": "1. Unboxing and Setup"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Included in the Box: Velvera Pad, 33W/45W USB-C power adapter, USB-C cable, Quick Start Guide, SIM ejector tool (Pro models only)",
                        "depth": 0
                      },
                      {
                        "text": "Optional Accessories: Velvera Pencil, Velvera Keyboard",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": [
                  {
                    "title": "Step-by-Step Setup:",
                    "level": 4,
                    "location": {
                      "line": 9,
                      "heading": "1. Unboxing and Setup"
                    },
                    "blocks": [
                      {
                        "type": "list",
                        "location": {
                          "line": 10,
                          "heading": "Step-by-Step Setup:"
                        },
                        "ordered": true,
                        "items": [
                          {
                            "text": "Power On:\nPress and hold the power button (right edge).",
                            "depth": 0
                          },
                          {
                            "text": "Language & Region:\nFollow on-screen prompts to select your language and region.",
                            "depth": 0
                          },
                          {
                            "text": "Wi-Fi/Network Connection:",
                            "depth": 0
                          },
                          {
                            "text": "All models: Connect to Wi-Fi 6/6E.",
                            "depth": 1
                          },
                          {
                            "text": "Pad Pro: Optionally insert nano SIM for 5G cellular network.",
                            "depth": 1
                          },
                          {
                            "text": "Google Account Sign-In:\nSign in to your Google account for Play Store and sync services.",
                            "depth": 0
                          },
                          {
                            "text": "System Updates:\nAllow Velvera UI to check for and install available updates.",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  }
                ]
              },
              {
                "title": "2. Charging Your Tablet",
                "level": 3,
                "location": {
                  "line": 24,
                  "heading": "Getting Started"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 25,
                      "heading": "2. Charging Your Tablet"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Charging Port: USB-C (bottom left edge)",
                        "depth": 0
                      },
                      {
                        "text": "Supported Charging:",
                        "depth": 0
                      },
                      {
                        "text": "Pad 11\": Up to 33W fast charging, full charge ~2.5 hours",
                        "depth": 1
                      },
                      {
                        "text": "Pad Pro 12.9\": Up to 45W ultra-fast charging, full charge ~2 hours",
                        "depth": 1
                      },
                      {
                        "text": "Battery Tips: Use the included adapter for optimal charging speed. Avoid letting the battery fully deplete for longer life.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
