          {
            "title": "What’s Included",
            "level": 2,
            "location": {
              "line": 43,
              "heading": "Velvera Plus — Extended Protection & Accidental Damage Plan"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 45,
                  "heading": "What’s Included"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Extended Warranty: Adds 1 or 2 years (total up to 3 years) device warranty, including all manufacturing defects.",
                    "depth": 0
                  },
                  {
                    "text": "Accidental Damage Protection: Covers screen, body, and internal hardware repairs due to accidental drops, liquid spills, electrical surges, and more (2 claims per year, deductible applies).",
                    "depth": 0
                  },
                  {
                    "text": "Battery Coverage: Free replacement for performance degradation (max 2 batteries during coverage).",
                    "depth": 0
                  },
                  {
                    "text": "Express Replacement Service: Receive a replacement device before returning the original for eligible issues.",
                    "depth": 0
                  },
                  {
                    "text": "Priority Support: 24x7 hotline and live chat access with expert technicians.",
                    "depth": 0
                  },
                  {
                    "text": "International Service: Coverage honored at authorized Velvera service points globally.",
                    "depth": 0
                  },
                  {
                    "text": "Free Shipping for Repairs: Doorstep pickup and delivery for service requests (up to 2 times per year).",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Eligibility & Enrollment",
            "level": 2,
            "location": {
              "line": 55,
              "heading": "Velvera Plus — Extended Protection & Accidental Damage Plan"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 57,
                  "heading": "Eligibility & Enrollment"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Eligible Devices: All new Velvera smartphones, tablets, watches, and audio products purchased from authorized sales channels.",
                    "depth": 0
                  },
                  {
                    "text": "Enrollment Window: Within 120 days of original purchase date.",
                    "depth": 0
                  },
                  {
                    "text": "Plan Transfer: Coverage transfers automatically if device ownership changes via Velvera’s official transfer portal.",
                    "depth": 0
                  },
                  {
                    "text": "Coverage Start: Begins on the date of original device purchase.",
                    "depth": 0
                  },
                  {
                    "text": "Proof of Purchase: Required at time of service request.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Claim Process",
            "level": 2,
            "location": {
              "line": 65,
              "heading": "Velvera Plus — Extended Protection & Accidental Damage Plan"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 67,
                  "heading": "Claim Process"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Contact Support: Reach out via toll-free support, email, or in-app Service tab.",
                    "depth": 0
                  },
                  {
                    "text": "Remote Troubleshooting: Velvera agents diagnose the issue.",
                    "depth": 0
                  },
                  {
                    "text": "Pickup & Service: For damages or hardware issues, Velvera arranges pickup (where available); most repairs completed within 3–5 business days.",
                    "depth": 0
                  },
                  {
                    "text": "Express Replacement: For major faults or urgent needs, eligible customers receive a replacement device in advance.",
                    "depth": 0
                  },
                  {
                    "text": "Claim Limitation: Maximum of 2 accidental damage claims per year; unlimited hardware defect claims during coverage.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Additional Terms",
            "level": 2,
            "location": {
              "line": 76,
              "heading": "Velvera Plus — Extended Protection & Accidental Damage Plan"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 78,
                  "heading": "Additional Terms"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Deductible/Service Fee: For each accidental damage claim, a nominal fee applies (“screen: ₹1,199/US$15; other: ₹1,999/US$24 per claim”).",
                    "depth": 0
                  },
                  {
                    "text": "What’s Not Covered: Loss/theft, intentional damage, unauthorized repairs, accessories (unless enrolled specifically), or cosmetic-only issues are not included.",
                    "depth": 0
                  },
                  {
                    "text": "Cancellation & Refunds: Full refund within 30 days of plan activation if unused. Pro-rated refund available within coverage period if no claims made.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
