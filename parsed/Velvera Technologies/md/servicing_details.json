            },
            "ordered": false,
            "items": [
              {
                "text": "Service booking: Initiate via Velvera App, website, or by contacting the nearest service center.",
                "depth": 0
              },
              {
                "text": "Diagnosis: Certified engineers assess reported issues, typically within 24 hours of product receipt.",
                "depth": 0
              },
              {
                "text": "Quote & Approval: Estimate shared for any non-warranty services or accidental damage; repairs begin post-approval.",
                "depth": 0
              },
              {
                "text": "Status Tracking: Transparent updates through app, SMS, and email notifications.",
                "depth": 0
              },
              {
                "text": "Delivery & Feedback: Products can be collected in person or delivered to the customer’s address upon request.",
                "depth": 0
              }
            ]
          },
