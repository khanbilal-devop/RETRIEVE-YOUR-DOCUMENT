          {
            "title": "Frequently Asked Questions",
            "level": 2,
            "location": {
              "line": 133,
              "heading": "Cendara University Enrollment Procedures"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 135,
                  "heading": "Frequently Asked Questions"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "How do I know if a course is required for my major?\nRefer to your degree audit in MyCendara or consult your advisor for clarification.",
                    "depth": 0
                  },
                  {
                    "text": "What happens if I miss the registration deadline?\nLate registrations are not guaranteed and incur late fees. Contact the Registrar’s Office immediately.",
                    "depth": 0
                  },
                  {
                    "text": "Can I take courses in more than one department?\nYes, as long as you meet prerequisites and credit load policies.",
                    "depth": 0
                  },
                  {
                    "text": "When will I get my university ID card?\nID cards are issued at Orientation or may be picked up from the Student Affairs Office after registration is confirmed.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 146,
                  "heading": "Frequently Asked Questions"
                },
                "text": "For further information, review the full Student Handbook (https://cendara.edu/student-handbook) or contact an enrollment advisor."
              }
            ],
            "sections": []
          }
        ]
      }
    ]
  }
