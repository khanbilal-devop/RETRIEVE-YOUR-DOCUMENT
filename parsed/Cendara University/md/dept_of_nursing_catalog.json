                "location": {
                  "line": 37,
                  "heading": "Year 1 Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 38,
                      "heading": "NURS 120: Health Assessment"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nOffers theoretical and practical foundations in physical assessment techniques, including the use of diagnostic equipment and patient interviewing.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: NURS 111 (may be taken concurrently)",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours: 3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "NURS 130: Introduction to Clinical Practice",
                "level": 3,
                "location": {
                  "line": 45,
                  "heading": "Year 1 Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 46,
                      "heading": "NURS 130: Introduction to Clinical Practice"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nProvides supervised clinical experiences in a laboratory and hospital setting. Focus on basic nursing skills such as hygiene, infection control, and patient mobility.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: NURS 101, NURS 111",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours: 3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
