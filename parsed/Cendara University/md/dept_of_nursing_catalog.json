                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 5,
                      "heading": "B.N.S. in Nursing — Course Catalog"
                    },
                    "text": "The Bachelor of Nursing Science (B.N.S.) program at Cendara University is designed to prepare students for registered nurse licensure and to excel in modern clinical environments. The curriculum blends rigorous academic coursework with hands-on experience in partner hospitals."
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 7,
                      "heading": "B.N.S. in Nursing — Course Catalog"
                    },
                    "text": "Below is a comprehensive catalog of undergraduate courses offered by the Department of Nursing. Each listing includes the course title, code, detailed description, prerequisites, and credit hours."
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "Year 1 Courses",
            "level": 2,
            "location": {
              "line": 11,
              "heading": "Cendara University"
            },
            "blocks": [],
            "sections": [
              {
                "title": "NURS 101: Foundations of Professional Nursing",
                "level": 3,
                "location": {
                  "line": 13,
                  "heading": "Year 1 Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 14,
                      "heading": "NURS 101: Foundations of Professional Nursing"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nIntroduces the core principles, history, and ethical standards of the nursing profession. Emphasizes patient-centered care, communication skills, and professional conduct.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: None",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours: 3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "NURS 111: Human Anatomy & Physiology I",
                "level": 3,
                "location": {
                  "line": 21,
                  "heading": "Year 1 Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 22,
                      "heading": "NURS 111: Human Anatomy & Physiology I"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nFocuses on the structural and functional organization of the human body with emphasis on the musculoskeletal, nervous, and cardiovascular systems.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: None",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours: 4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "NURS 112: Human Anatomy & Physiology II",
                "level": 3,
                "location": {
                  "line": 29,
                  "heading": "Year 1 Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 30,
                      "heading": "NURS 112: Human Anatomy & Physiology II"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nContinues NURS 111 with a focus on the respiratory, digestive, urinary, and reproductive systems. Includes laboratory sessions and case studies.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: NURS 111",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours: 4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "NURS 120: Health Assessment",
