        "title": "Cendara University Undergraduate and Graduate Fee Structure",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "Cendara University Undergraduate and Graduate Fee Structure"
            },
            "text": "Cendara University is committed to providing a transparent overview of the expected costs associated with enrollment. The fee ranges outlined below are for the academic year 2024–2025 and apply to both domestic and international students. Actual charges may vary based on chosen program, housing selection, dining preference, and individual course loads."
          }
        ],
        "sections": [
          {
            "title": "1. Tuition",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "Cendara University Undergraduate and Graduate Fee Structure"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 9,
                  "heading": "1. Tuition"
                },
                "text": "Tuition varies by degree level and academic program. The following ranges represent annual full-time enrollment (24–30 credits undergraduate, 18–24 credits graduate):"
              },
              {
                "type": "table",
                "location": {
                  "line": 11,
                  "heading": "1. Tuition"
                },
                "header": [
                  "Program/Degree",
                  "Tuition Range (Per Year)"
                ],
                "rows": [
                  [
                    "Bachelor of Arts/Science/Engineering",
                    "$24,000 – $29,000"
                  ],
                  [
                    "Bachelor of Business Administration/Nursing",
                    "$26,000 – $32,000"
                  ],
                  [
                    "Bachelor of Education",
                    "$23,500 – $26,500"
                  ],
                  [
                    "Master of Arts/Science/Engineering",
                    "$13,500 – $18,200"
                  ],
                  [
                    "Master of Business Administration/Public Health",
                    "$17,800 – $21,400"
                  ],
                  [
                    "Doctor of Philosophy (Ph.D.)",
                    "$16,500 – $23,000"
                  ],
                  [
                    "Graduate Certificate Programs",
                    "$9,800 – $12,500 (per certificate)"
                  ]
                ]
              },
              {
                "type": "list",
                "location": {
                  "line": 21,
                  "heading": "1. Tuition"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Part-Time Tuition: Calculated per credit hour, typically $900 – $1,200/credit (undergraduate); $1,050 – $1,500/credit (graduate)",
                    "depth": 0
                  },
                  {
                    "text": "International students: Add $2,000 – $5,000 annually for certain programs",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
