          {
            "title": "7. Important Notes",
            "level": 2,
            "location": {
              "line": 103,
              "heading": "Cendara University Undergraduate and Graduate Fee Structure"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 105,
                  "heading": "7. Important Notes"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Scholarships, grants, and financial aid are available; contact the Office of Financial Assistance for eligibility.",
                    "depth": 0
                  },
                  {
                    "text": "Some specialized programs (e.g., Nursing, Engineering, Study Abroad) may charge additional instructional or experiential fees.",
                    "depth": 0
                  },
                  {
                    "text": "All fees are subject to annual review and adjustment by the Board of Trustees.",
                    "depth": 0
                  },
                  {
                    "text": "Billing is conducted on a semester basis; flexible payment plans are available upon request.",
                    "depth": 0
                  },
                  {
                    "text": "Questions about campus fees should be addressed to bursar@cendara.edu.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 113,
                  "heading": "7. Important Notes"
                },
                "text": "For complete policy details, including payment deadlines and refund schedules, please refer to the Cendara University Student Accounts Handbook (https://accounts.cendara.edu/handbook)."
