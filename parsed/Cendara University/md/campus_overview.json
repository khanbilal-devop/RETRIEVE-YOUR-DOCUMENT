            "sections": [
              {
                "title": "Academic Buildings",
                "level": 3,
                "location": {
                  "line": 11,
                  "heading": "Physical Description of Facilities"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 13,
                      "heading": "Academic Buildings"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Morgan Academic Complex\nConstructed: 1974, Renovated 2017\nDescription: Three interconnected wings house 60 classrooms, 7 computer labs, and 15 faculty offices. The complex supports the College of Arts & Humanities and features multimedia-enabled lecture halls (maximum capacity: 250 students each).",
                        "depth": 0
                      },
                      {
                        "text": "Rosenfeld Science Center\nConstructed: 1983, Expanded 2015\nDescription: A four-story structure dedicated to the Departments of Biology, Chemistry, and Environmental Sciences. Facilities include:",
                        "depth": 0
                      },
                      {
                        "text": "8 research laboratories (BSL-2 and chemistry wet labs)",
                        "depth": 1
                      },
                      {
                        "text": "2 lecture auditoriums (seating 160 and 120)",
                        "depth": 1
                      },
                      {
                        "text": "A rooftop greenhouse (2,500 sq. ft.)",
                        "depth": 1
                      },
                      {
                        "text": "A microscopy imaging core",
                        "depth": 1
                      },
                      {
                        "text": "Helena L. Martin Engineering Hall\nOpened: 2005\nDescription: Features workshop spaces, prototyping rooms, 12 teaching labs, and a design center supporting civil, electrical, and mechanical engineering programs.",
                        "depth": 0
                      },
                      {
                        "text": "Mendell Business Pavilion\nConstructed: 1991\nHighlights:",
                        "depth": 0
                      },
                      {
                        "text": "10 seminar rooms with tiered seating",
                        "depth": 1
                      },
                      {
                        "text": "Real-time financial data lab",
                        "depth": 1
                      },
                      {
                        "text": "Entrepreneurship incubator suite (capacity: 40 student teams)",
                        "depth": 1
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
