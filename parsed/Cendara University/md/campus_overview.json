          {
            "title": "Introduction",
            "level": 2,
            "location": {
              "line": 3,
              "heading": "Cendara University Campus Overview"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 5,
                  "heading": "Introduction"
                },
                "text": "Founded in 1972, Cendara University spans a 180-acre campus nestled on the eastern edge of Windham City. The campus combines modern innovation with a respect for natural landscapes, offering an environment conducive to academic excellence and community engagement."
              }
            ],
            "sections": []
          },
          {
