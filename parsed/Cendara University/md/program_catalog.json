          {
            "title": "Specialized Programs",
            "level": 2,
            "location": {
              "line": 80,
              "heading": "Cendara University Academic Programs Summary"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 82,
                  "heading": "Specialized Programs"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Honors College: Interdisciplinary honors curriculum for high-achieving undergraduates across all schools.",
                    "depth": 0
                  },
                  {
                    "text": "Sustainable Technology Initiative: Focused track within Engineering on renewable energy and sustainable infrastructure.",
                    "depth": 0
                  },
                  {
                    "text": "International Business Concentration: Specialized track within B.B.A. and M.B.A. integrating global business studies.",
                    "depth": 0
                  },
                  {
                    "text": "Undergraduate Research Scholars Program: Mentoring and research funding for undergraduates in STEM fields.",
                    "depth": 0
                  },
                  {
                    "text": "Global Education Exchange: Semester-abroad and dual-degree programs with partner institutions in Europe and Asia.",
                    "depth": 0
                  },
                  {
                    "text": "Teacher Residency Program: A year-long mentored teaching placement for M.Ed. students in area schools.",
                    "depth": 0
                  },
                  {
                    "text": "Health Informatics Certification: Post-baccalaureate certificate offered through Health Sciences.",
                    "depth": 0
                  },
                  {
                    "text": "Environmental Policy Minor: Interdisciplinary minor drawing on Environmental Engineering, Political Science, and Economics.",
                    "depth": 0
                  }
                ]
              }
            ],
