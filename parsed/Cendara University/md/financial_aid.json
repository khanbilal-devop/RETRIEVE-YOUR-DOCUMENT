                      "heading": "Step 1: Gather Required Documents"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Student and parent tax returns (prior-prior year, e.g., 2022 for 2024–25)",
                        "depth": 0
                      },
                      {
                        "text": "W-2s and other income statements",
                        "depth": 0
                      },
                      {
                        "text": "Bank statements and records of investments",
                        "depth": 0
                      },
                      {
                        "text": "Social Security numbers or governmental IDs (if applicable)",
                        "depth": 0
                      },
                      {
                        "text": "Academic transcripts for some merit aid",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
