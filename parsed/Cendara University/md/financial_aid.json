          {
            "title": "5. Work-Study Employment",
            "level": 2,
            "location": {
              "line": 96,
              "heading": "Cendara University Financial Aid Guide"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 98,
                  "heading": "5. Work-Study Employment"
                },
                "text": "Cendara’s Federal and Institutional Work-Study programs provide part-time, on-campus jobs to assist students in meeting expenses."
              },
              {
                "type": "list",
                "location": {
                  "line": 100,
                  "heading": "5. Work-Study Employment"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Typical positions: Library assistant, lab tech, campus events, dining hall, research aide",
                    "depth": 0
                  },
                  {
                    "text": "Hourly pay: $12 – $15 (undergraduate), $14 – $18 (graduate)",
                    "depth": 0
                  },
                  {
                    "text": "Maximum hours: 15/week during terms",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 104,
                  "heading": "5. Work-Study Employment"
                },
                "text": "Eligibility depends on need and timely application; indicate work-study interest on the FAFSA or Cendara Application for Aid."
              }
            ],
            "sections": []
          },
          {
