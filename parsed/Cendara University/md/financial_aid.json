              {
                "title": "Step 4: Meet All Deadlines",
                "level": 3,
                "location": {
                  "line": 136,
                  "heading": "6. Application Procedures"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 138,
                      "heading": "Step 4: Meet All Deadlines"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Priority Deadline: February 15, 2024 (for maximum consideration)",
                        "depth": 0
                      },
                      {
                        "text": "Cendara Scholarship Portal: Opens October 1, closes March 1",
                        "depth": 0
                      },
                      {
                        "text": "FAFSA/CSS Profile: Opens October 1; final deadline May 1",
                        "depth": 0
                      },
                      {
                        "text": "Department/Graduate Scholarships: Vary by unit (consult website)",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Step 5: Review Aid Offer & Accept",
                "level": 3,
                "location": {
                  "line": 143,
                  "heading": "6. Application Procedures"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 145,
                      "heading": "Step 5: Review Aid Offer & Accept"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Cendara’s Office of Financial Assistance will send an “Aid Notification” via email/portal.",
                        "depth": 0
                      },
                      {
                        "text": "Review your offer, accept/decline individual items online.",
                        "depth": 0
                      },
                      {
                        "text": "Submit additional documents if requested (tax forms, clarification letters, etc.)",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Step 6: Maintain Eligibility",
                "level": 3,
                "location": {
                  "line": 149,
                  "heading": "6. Application Procedures"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 151,
                      "heading": "Step 6: Maintain Eligibility"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Must be enrolled at least half-time each semester (≥ 12 credits undergraduate, ≥ 9 credits graduate unless otherwise stated)",
                        "depth": 0
                      },
                      {
                        "text": "Maintain Satisfactory Academic Progress (minimum GPA 2.0 undergrad/3.0 grad, 67% completion rate)",
                        "depth": 0
                      },
                      {
                        "text": "Renew FAFSA or applicable forms each year",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "7. Additional Financial Support Resources",
            "level": 2,
            "location": {
              "line": 157,
              "heading": "Cendara University Financial Aid Guide"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 159,
                  "heading": "7. Additional Financial Support Resources"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Outside Scholarships: Students encouraged to apply for external awards (employers, civic groups, national competitions).",
                    "depth": 0
                  },
                  {
                    "text": "Payment Plans: Flexible semester installment plans available via the Bursar’s Office.",
                    "depth": 0
                  },
                  {
                    "text": "Emergency Assistance Fund: One-time support for unforeseen crises; contact deanofstudents@cendara.edu.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "8. Frequently Asked Questions",
            "level": 2,
            "location": {
              "line": 165,
              "heading": "Cendara University Financial Aid Guide"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 167,
                  "heading": "8. Frequently Asked Questions"
                },
                "text": "Q: Can I combine multiple scholarships or grants?\nA: Yes, but total aid may not exceed direct costs (tuition, fees, room/board). Some awards have restrictions; always check notifications."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 170,
                  "heading": "8. Frequently Asked Questions"
                },
                "text": "Q: I missed the deadline. Can I still apply?\nA: Late applications are accepted, but funding may be limited. Contact the Office of Financial Assistance for guidance."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 173,
                  "heading": "8. Frequently Asked Questions"
                },
                "text": "Q: What if my family’s financial situation has recently changed?\nA: Submit a Special Circumstances Appeal form with supporting documentation for re-evaluation of your aid package."
              }
            ],
            "sections": []
          },
