    "sections": [
      {
        "title": "Cendara University Financial Aid Guide",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 2,
              "heading": "Cendara University Financial Aid Guide"
            },
            "text": "Academic Year 2024–2025"
          },
          {
            "type": "paragraph",
            "location": {
              "line": 4,
              "heading": "Cendara University Financial Aid Guide"
            },
            "text": "The Office of Financial Assistance is dedicated to making a Cendara University education accessible and affordable. Cendara offers a range of scholarships, grants, loans, and work-study opportunities to help offset educational expenses outlined in the annual fee structure. This guide details available aid programs and provides step-by-step application instructions."
          },
          {
            "type": "paragraph",
            "location": {
              "line": 6,
              "heading": "Cendara University Financial Aid Guide"
            },
            "text": "To contact us:\nOffice of Financial Assistance\n2nd Floor, Founders Hall\nEmail: financial.aid@cendara.edu | Phone: (317) 555-2473"
          }
        ],
        "sections": [
          {
            "title": "1. Types of Financial Aid",
            "level": 2,
            "location": {
              "line": 13,
              "heading": "Cendara University Financial Aid Guide"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 15,
                  "heading": "1. Types of Financial Aid"
                },
                "text": "Cendara University offers the following forms of assistance:"
              },
              {
                "type": "list",
                "location": {
                  "line": 17,
                  "heading": "1. Types of Financial Aid"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Scholarships: Merit-based, talent-based, and need-based awards that do not require repayment.",
                    "depth": 0
                  },
                  {
                    "text": "Grants: Need-based aid, typically from university, state, or federal sources; no repayment required.",
                    "depth": 0
                  },
                  {
                    "text": "Loans: Borrowed funds that must be repaid with interest; both federal and institutional loans are available.",
                    "depth": 0
                  },
                  {
                    "text": "Work-Study: Part-time campus employment to earn money during the academic year.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 22,
                  "heading": "1. Types of Financial Aid"
                },
                "text": "Each student may be eligible for a combination of these aid types."
              }
            ],
            "sections": []
          },
