            "sections": [
              {
                "title": "Bachelor of Education (B.Ed.) in Elementary Education",
                "level": 3,
                "line": 7,
                "blocks": [],
                "sections": [
                  {
                    "title": "EDUC 1101: Foundations of Education",
                    "level": 4,
                    "line": 11,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 12,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nIntroduction to the philosophy, history, and social context of elementary education. Topics include educational theories, current issues in teaching, and the role of educators in diverse classrooms.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: None",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 1202: Child Development and Learning",
                    "level": 4,
                    "line": 19,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 20,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nExamination of key physical, cognitive, and social-emotional development stages in children aged 4–12. Explores theories of learning and their application in diverse elementary classrooms.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: None",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 1303: Curriculum Design for Elementary Classrooms",
                    "level": 4,
                    "line": 27,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 28,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nStudy of principles and models of curriculum development. Students will develop lesson plans and curricular units aligned with state and national standards.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 1101",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 1404: Literacy Instruction I",
                    "level": 4,
                    "line": 35,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 36,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nApproaches to teaching reading and writing from kindergarten through third grade. Emphasizes phonemic awareness, phonics, and early literacy strategies.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 1202",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 1505: Mathematics for Elementary Teachers",
                    "level": 4,
                    "line": 43,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 44,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nContent and methods for effective mathematics instruction at the elementary level, including numeracy, problem-solving, and assessment techniques.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 1101",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 2106: Classroom Assessment and Evaluation",
                    "level": 4,
                    "line": 51,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 52,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nPrinciples and practices of student assessment, including formative, summative, and alternative forms. Focus on data-driven instruction to improve student outcomes.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 1303",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 2207: Literacy Instruction II",
                    "level": 4,
                    "line": 59,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 60,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nStrategies for reading comprehension and writing instruction, grades 4–6. Focuses also on differentiated instruction for students with varying abilities.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 1404",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 2308: Science and Social Studies Methods",
                    "level": 4,
                    "line": 67,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 68,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nIntegration of science and social studies content and pedagogy, with an emphasis on inquiry-based learning and interdisciplinary instruction.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 1303",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 3109: Inclusive Classrooms and Special Needs Education",
                    "level": 4,
                    "line": 75,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 76,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nMethods for supporting diverse learners, including those with exceptionalities and English language learners. Legal and ethical aspects of inclusion addressed.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 2106",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 3110: Classroom Management",
                    "level": 4,
                    "line": 83,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 84,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nTechniques for creating positive learning environments, managing student behavior, and implementing preventative strategies.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 2106",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 4201: Student Teaching Seminar",
                    "level": 4,
                    "line": 91,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 92,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nCapstone seminar to support students completing their student teaching experience. Emphasizes reflective practice, professional development, and portfolio creation.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: Completion of all prior B.Ed. coursework; approval of Department Chair",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDUC 4202: Student Teaching Practicum",
                    "level": 4,
                    "line": 99,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 100,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nSupervised full-time teaching placement in a local elementary school. Students apply pedagogical theories in real-world settings.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDUC 4201",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 6",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  }
