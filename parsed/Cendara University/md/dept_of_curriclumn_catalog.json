                    ],
                    "sections": []
                  },
                  {
                    "title": "EDCI 5102: Advanced Instructional Theory",
                    "level": 4,
                    "line": 120,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 121,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nIn-depth analysis of learning theories, instructional models, and evidence-based practices for enhancing student achievement across grade levels.",
