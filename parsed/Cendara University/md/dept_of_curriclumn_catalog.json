                    "level": 4,
                    "line": 136,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 137,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nIntroduction to qualitative and quantitative educational research methodologies, including data collection, analysis, and interpretation for classroom settings.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: None",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
