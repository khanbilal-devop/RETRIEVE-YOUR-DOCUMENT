                    "line": 152,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 153,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nExamination of approaches to fostering inclusive and equitable learning environments. Topics include anti-bias education and culturally responsive pedagogy.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDCI 5001",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
