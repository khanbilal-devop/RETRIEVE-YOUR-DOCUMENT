                    "level": 4,
                    "line": 144,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 145,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nStrategies for selecting and implementing digital tools and resources to enhance teaching and learning. Includes evaluation of emerging educational technologies.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: None",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
