                          },
                          {
                            "text": "Prerequisites: EDCI 5001",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "EDCI 5203: Curriculum Development and Evaluation",
                    "level": 4,
                    "line": 128,
                    "blocks": [
                      {
                        "type": "list",
                        "line": 129,
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nStudy of systematic approaches to designing, implementing, and assessing curricula using quantitative and qualitative methods.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: EDCI 5001",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
