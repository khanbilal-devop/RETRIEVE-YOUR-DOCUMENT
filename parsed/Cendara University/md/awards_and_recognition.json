                    "ordered": false,
                    "items": [
                      {
                        "text": "Top Regional University Award\nGranted by the Eastern Academic Review Board for outstanding academic innovation and student satisfaction.",
                        "depth": 0
                      },
                      {
                        "text": "Excellence in Diversity and Inclusion (Gold Level)\nAwarded by the National Association for Inclusive Education (NAIE) for Cendara’s “Bridge Horizons” initiative, boosting underrepresented groups in STEM by 35%.",
                        "depth": 0
                      },
                      {
                        "text": "Innovative Campus Sustainability Program Award\nRecognized by the Green Futures Alliance for the comprehensive “Solar Steps” campus energy overhaul, including solar canopy installations and electric fleet conversion.",
                        "depth": 0
                      }
                    ]
                  }
                ],
