                "blocks": [],
                "sections": [
                  {
                    "title": "Chancellor’s Award for Excellence in Teaching",
                    "level": 4,
                    "location": {
                      "line": 8,
                      "heading": "2023–2024 University Honors"
                    },
                    "blocks": [
                      {
                        "type": "paragraph",
                        "location": {
                          "line": 9,
                          "heading": "Chancellor’s Award for Excellence in Teaching"
                        },
                        "text": "Recipient: Dr. Simone L. Marquez\nDepartment: Mathematics\nPresented on: May 4, 2024\nCitation:\nDr. Marquez is recognized for distinguished teaching and innovative curriculum development in applied mathematics. Her engaging approach and dedication to student mentorship have significantly improved departmental outcomes."
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "Distinguished Alumni Achievement Award",
                    "level": 4,
                    "location": {
                      "line": 17,
                      "heading": "2023–2024 University Honors"
                    },
                    "blocks": [
                      {
                        "type": "paragraph",
                        "location": {
                          "line": 18,
                          "heading": "Distinguished Alumni Achievement Award"
                        },
                        "text": "Recipient: Dr. Priyanka Halson (Class of 2005)\nField: Medical Research\nPresented on: March 15, 2024\nCitation:\nDr. Halson, Director of Cardiology at Meridian General Hospital, has pioneered advancements in heart disease diagnostics, receiving international acclaim. Her commitment to global health advocacy exemplifies Cendara values."
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "Staff Service Recognition",
                    "level": 4,
                    "location": {
                      "line": 26,
                      "heading": "2023–2024 University Honors"
                    },
                    "blocks": [
                      {
                        "type": "paragraph",
                        "location": {
                          "line": 27,
                          "heading": "Staff Service Recognition"
                        },
                        "text": "Recipient: Mr. James O. Felix\nDepartment: Facilities & Operations\nYears of Service: 25\nPresented on: December 10, 2023\nCitation:\nMr. Felix’s long-standing dedication has been vital to campus safety and sustainability initiatives. His efforts have contributed to Cendara attaining a regional Green Campus certification."
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "Undergraduate Research Excellence Award",
                    "level": 4,
                    "location": {
                      "line": 36,
                      "heading": "2023–2024 University Honors"
                    },
                    "blocks": [
                      {
                        "type": "paragraph",
                        "location": {
                          "line": 37,
                          "heading": "Undergraduate Research Excellence Award"
                        },
                        "text": "Recipient: Maya Elise Greene\nMajor: Environmental Science\nPresented on: May 2, 2024\nCitation:\nMaya’s project on river pollution and restoration in the Cendara Valley garnered publication in the Northeast Ecology Review and shaped local environmental policy recommendations."
                      }
                    ],
                    "sections": []
                  }
                ]
              },
              {
