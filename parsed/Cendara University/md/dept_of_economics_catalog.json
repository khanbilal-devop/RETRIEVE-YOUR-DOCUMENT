            "blocks": [],
            "sections": [
              {
                "title": "ECON 101: Principles of Microeconomics",
                "level": 3,
                "location": {
                  "line": 12,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 13,
                      "heading": "ECON 101: Principles of Microeconomics"
                    },
                    "text": "Credits: 3\nDescription:\nIntroduction to microeconomic theory, including supply and demand, market structures, consumer behavior, and the role of government. Emphasis on real-world applications and critical thinking about everyday economic issues.\nPrerequisites: None"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 102: Principles of Macroeconomics",
                "level": 3,
                "location": {
                  "line": 20,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 21,
                      "heading": "ECON 102: Principles of Macroeconomics"
                    },
                    "text": "Credits: 3\nDescription:\nFoundations of macroeconomics: national income, economic growth, unemployment, inflation, monetary and fiscal policy. Analysis of current macroeconomic challenges and policy debates.\nPrerequisites: None"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 201: Intermediate Microeconomics",
                "level": 3,
                "location": {
                  "line": 28,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 29,
                      "heading": "ECON 201: Intermediate Microeconomics"
                    },
                    "text": "Credits: 3\nDescription:\nDetailed study of consumer theory, production and costs, market equilibrium, and competitive markets. Introduction to strategic behavior and market failures.\nPrerequisites: ECON 101"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 202: Intermediate Macroeconomics",
                "level": 3,
                "location": {
                  "line": 36,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 37,
                      "heading": "ECON 202: Intermediate Macroeconomics"
                    },
                    "text": "Credits: 3\nDescription:\nExamination of economic growth, business cycles, aggregate demand and supply, and the impacts of monetary and fiscal policies on national and global economies.\nPrerequisites: ECON 102"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 210: Statistics for Economists",
                "level": 3,
                "location": {
                  "line": 44,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 45,
                      "heading": "ECON 210: Statistics for Economists"
                    },
                    "text": "Credits: 3\nDescription:\nIntroduction to statistical concepts, probability theory, and data analysis in economics. Hands-on experience with statistical software and interpretation of economic data sets.\nPrerequisites: None"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 221: Introduction to Econometrics",
                "level": 3,
                "location": {
                  "line": 52,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 53,
                      "heading": "ECON 221: Introduction to Econometrics"
                    },
                    "text": "Credits: 3\nDescription:\nStatistical techniques in estimating economic models: regression analysis, hypothesis testing, and forecasting. Practical applications using real-world data.\nPrerequisites: ECON 210"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 230: Money and Banking",
                "level": 3,
                "location": {
                  "line": 60,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 61,
                      "heading": "ECON 230: Money and Banking"
                    },
                    "text": "Credits: 3\nDescription:\nStudy of money, banking systems, and financial institutions. Analysis of central banking, monetary policy, and their effects on the economy.\nPrerequisites: ECON 102"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 240: International Economics",
                "level": 3,
                "location": {
                  "line": 68,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 69,
                      "heading": "ECON 240: International Economics"
                    },
                    "text": "Credits: 3\nDescription:\nTheories of international trade, exchange rates, trade policy, and their impact on global economic relations. Discussion of current international economic issues.\nPrerequisites: ECON 101, ECON 102"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 270: Development Economics",
                "level": 3,
                "location": {
                  "line": 76,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 77,
                      "heading": "ECON 270: Development Economics"
                    },
                    "text": "Credits: 3\nDescription:\nExamination of economic development in low- and middle-income countries. Focus on poverty, inequality, population growth, and policy strategies for promoting sustainable development.\nPrerequisites: ECON 102"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 310: Public Finance",
                "level": 3,
                "location": {
                  "line": 84,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 85,
                      "heading": "ECON 310: Public Finance"
                    },
                    "text": "Credits: 3\nDescription:\nEconomic analysis of government expenditures and tax policies. Role of government in resource allocation, income distribution, and economic stability.\nPrerequisites: ECON 201"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 320: Game Theory and Strategic Behavior",
                "level": 3,
                "location": {
                  "line": 92,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 93,
                      "heading": "ECON 320: Game Theory and Strategic Behavior"
                    },
                    "text": "Credits: 3\nDescription:\nIntroduction to the fundamentals of game theory, including Nash equilibrium, repeated games, and applications to business, politics, and economics.\nPrerequisites: ECON 201"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 350: Labor Economics",
                "level": 3,
                "location": {
                  "line": 100,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 101,
                      "heading": "ECON 350: Labor Economics"
                    },
                    "text": "Credits: 3\nDescription:\nAnalysis of labor markets, wage determination, employment, and the effects of unions and government policies on labor outcomes.\nPrerequisites: ECON 201"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 360: Environmental Economics",
                "level": 3,
                "location": {
                  "line": 108,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 109,
                      "heading": "ECON 360: Environmental Economics"
                    },
                    "text": "Credits: 3\nDescription:\nStudy of the economics of environmental policy, natural resource management, and sustainability. Discussion of market-based solutions to environmental challenges.\nPrerequisites: ECON 201"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 399: Research Methods in Economics",
                "level": 3,
                "location": {
                  "line": 116,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 117,
                      "heading": "ECON 399: Research Methods in Economics"
                    },
                    "text": "Credits: 3\nDescription:\nTraining in empirical research design, data collection, and interpretation of results. Preparation for honors thesis or upper-level research projects.\nPrerequisites: ECON 221, Junior standing"
                  }
                ],
                "sections": []
              },
              {
                "title": "ECON 410: Senior Seminar in Economics",
                "level": 3,
                "location": {
                  "line": 124,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 125,
                      "heading": "ECON 410: Senior Seminar in Economics"
                    },
                    "text": "Credits: 3\nDescription:\nCapstone course requiring the completion and presentation of an independent research project. Emphasis on integrating theory, data, and policy analysis.\nPrerequisites: Senior standing, ECON 399"
                  }
                ],
