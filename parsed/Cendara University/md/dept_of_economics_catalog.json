                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 182,
                      "heading": "ECON 561: International Trade and Finance"
                    },
                    "text": "Credits: 3\nDescription:\nContemporary theory and practice of international trade, capital flows, exchange rates, and the global financial system.\nPrerequisites: ECON 240 or equivalent"
