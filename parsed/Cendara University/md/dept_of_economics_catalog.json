                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 158,
                      "heading": "ECON 510: Advanced Microeconomic Theory"
                    },
                    "text": "Credits: 4\nDescription:\nRigorous analysis of consumer and producer behavior, market equilibrium, general equilibrium, and welfare economics.\nPrerequisites: ECON 201 or equivalent"
