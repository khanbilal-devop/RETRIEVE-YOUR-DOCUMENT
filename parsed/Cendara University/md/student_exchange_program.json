            "sections": []
          },
          {
            "title": "5. How to Apply",
            "level": 2,
            "location": {
              "line": 85,
              "heading": "Cendara University Affiliations & Exchange Programs"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 87,
                  "heading": "5. How to Apply"
                },
                "text": "For Cendara University Students:"
              },
              {
                "type": "list",
                "location": {
                  "line": 89,
                  "heading": "5. How to Apply"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Attend a mandatory Exchange Program Information Session (monthly, OIA Conference Room).",
                    "depth": 0
                  },
                  {
                    "text": "Consult with academic advisors for course and credit transfer planning.",
                    "depth": 0
                  },
                  {
                    "text": "Submit complete application and supporting materials (transcript, personal statement, recommendation letter) by March 1 (Fall) or October 1 (Spring).",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 93,
                  "heading": "5. How to Apply"
                },
                "text": "For Inbound Students:"
              },
              {
                "type": "list",
                "location": {
                  "line": 95,
                  "heading": "5. How to Apply"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Must be nominated by partner institution coordinator.",
                    "depth": 0
                  },
                  {
                    "text": "Submit online application via Cendara University OIA Portal.",
                    "depth": 0
                  },
                  {
                    "text": "Provide proof of English proficiency (TOEFL iBT ≥ 80 or IELTS ≥ 6.0 unless enrolled in English-medium program).",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 99,
                  "heading": "5. How to Apply"
                },
                "text": "For Faculty/Researchers:"
              },
              {
                "type": "list",
                "location": {
                  "line": 101,
                  "heading": "5. How to Apply"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Contact departmental international liaison for available placements.",
                    "depth": 0
                  },
                  {
                    "text": "Prepare research proposal or teaching plan.",
                    "depth": 0
                  },
                  {
                    "text": "Attach CV and evidence of institutional support from home university.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
