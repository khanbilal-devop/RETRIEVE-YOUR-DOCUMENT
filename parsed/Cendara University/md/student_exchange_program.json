            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 32,
                  "heading": "2. Student Exchange Programs"
                },
                "text": "Cendara University’s Office of International Affairs (OIA) manages a diverse portfolio of exchange opportunities for both inbound and outbound students."
              }
            ],
            "sections": [
              {
                "title": "A. Outbound Exchange Programs",
                "level": 3,
                "location": {
                  "line": 34,
                  "heading": "2. Student Exchange Programs"
                },
                "blocks": [],
                "sections": [
                  {
                    "title": "Semester & Year-Long Exchanges",
                    "level": 4,
                    "location": {
                      "line": 36,
                      "heading": "A. Outbound Exchange Programs"
                    },
                    "blocks": [
                      {
                        "type": "list",
                        "location": {
                          "line": 38,
                          "heading": "Semester & Year-Long Exchanges"
                        },
                        "ordered": false,
                        "items": [
                          {
                            "text": "Eligibility: Fully enrolled undergraduate or graduate students, minimum GPA 3.0, language proficiency as required by host.",
                            "depth": 0
                          },
                          {
                            "text": "Destinations (2024/25 academic year):",
                            "depth": 0
                          },
                          {
                            "text": "Humboldt School of Technology, Berlin (Engineering)",
                            "depth": 1
                          },
                          {
                            "text": "Royal Institute of Social Sciences, London (Political Science & Sociology)",
                            "depth": 1
                          },
                          {
                            "text": "Université de la Loire, Tours (French Studies, Philosophy)",
                            "depth": 1
                          },
                          {
                            "text": "Victoria State University, Melbourne (Environmental Sciences, Marine Biology)",
                            "depth": 1
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "Summer Programs",
                    "level": 4,
                    "location": {
                      "line": 45,
                      "heading": "A. Outbound Exchange Programs"
                    },
                    "blocks": [
                      {
                        "type": "list",
                        "location": {
                          "line": 47,
                          "heading": "Summer Programs"
                        },
                        "ordered": false,
                        "items": [
                          {
                            "text": "East Asia Cultural Immersion (Seoul, Tokyo): 6-week program featuring language courses, company visits, and cultural excursions.",
                            "depth": 0
                          },
                          {
                            "text": "Pontifica Universidad del Sur (Santiago): 4-week Sustainability and Community Action project.",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  }
                ]
              },
              {
                "title": "B. Inbound Exchange Opportunities",
                "level": 3,
                "location": {
                  "line": 50,
                  "heading": "2. Student Exchange Programs"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 52,
                      "heading": "B. Inbound Exchange Opportunities"
                    },
                    "text": "Cendara University welcomes over 70 exchange students annually from partner institutions. The following services are provided:"
                  },
                  {
                    "type": "list",
                    "location": {
                      "line": 54,
                      "heading": "B. Inbound Exchange Opportunities"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Pre-arrival orientation",
                        "depth": 0
                      },
                      {
                        "text": "Dedicated exchange student housing in Sterling Residence Hall",
                        "depth": 0
                      },
                      {
                        "text": "Academic advising and language support",
                        "depth": 0
                      },
                      {
                        "text": "Peer mentorship and local culture introduction",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "3. Faculty & Researcher Exchange",
            "level": 2,
            "location": {
              "line": 61,
              "heading": "Cendara University Affiliations & Exchange Programs"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 63,
                  "heading": "3. Faculty & Researcher Exchange"
                },
                "text": "Faculty and research staff at Cendara University have access to:"
              },
              {
                "type": "list",
                "location": {
                  "line": 65,
                  "heading": "3. Faculty & Researcher Exchange"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Sabbatical Placement: Up to 2 semesters at Université de la Loire (Humanities Faculty) or Humboldt School of Technology (STEM departments).",
                    "depth": 0
                  },
                  {
                    "text": "Research Collaboration Grants: Joint funding with partner institutions for bi-annual themed workshops and collaborative research, e.g., the Royal Institute of Social Sciences' annual Urban Studies Colloquium.",
                    "depth": 0
                  },
                  {
                    "text": "Teaching Fellowships: Visiting faculty positions at East Asia University Consortium with curriculum development roles and teaching assignments.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "4. Visiting Scholars Program",
            "level": 2,
            "location": {
              "line": 71,
              "heading": "Cendara University Affiliations & Exchange Programs"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 73,
                  "heading": "4. Visiting Scholars Program"
                },
                "text": "The Visiting Scholars Program offers short-term residencies (2–12 months) for faculty and postdoctoral researchers affiliated with partner universities."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 75,
                  "heading": "4. Visiting Scholars Program"
                },
                "text": "2023–2024 Recent Visiting Scholars:"
              },
