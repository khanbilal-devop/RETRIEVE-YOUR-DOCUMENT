            "sections": [
              {
                "title": "BIOL 501 — Advanced Molecular Genetics",
                "level": 3,
                "location": {
                  "line": 149,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 151,
                      "heading": "BIOL 501 — Advanced Molecular Genetics"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nIn-depth analysis of genetic mechanisms at the molecular level. Topics include gene regulation, epigenetics, genomics, and CRISPR technologies. Lab includes genome editing techniques.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nUndergraduate degree in Biology or consent of instructor",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 512 — Cell Structure and Function",
                "level": 3,
                "location": {
                  "line": 160,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 162,
                      "heading": "BIOL 512 — Cell Structure and Function"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nAdvanced study of cellular architecture, signal transduction, and microscopy methods. Investigates cell dynamics using live-cell imaging and flow cytometry.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 311 or equivalent",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 523 — Population and Quantitative Genetics",
                "level": 3,
                "location": {
                  "line": 171,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 173,
                      "heading": "BIOL 523 — Population and Quantitative Genetics"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nExplores genetic variation within populations, heritability, genetic mapping, and genome-wide association studies. Includes hands-on analysis with bioinformatics tools.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 221 or consent of instructor",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 540 — Conservation and Restoration Ecology",
                "level": 3,
                "location": {
                  "line": 182,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 184,
                      "heading": "BIOL 540 — Conservation and Restoration Ecology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nEvaluation of theoretical and practical approaches to ecosystem restoration and conservation. Emphasizes adaptive management, population viability analysis, and conservation policy.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 235 or graduate standing",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 558 — Current Topics in Marine Biology",
                "level": 3,
                "location": {
                  "line": 193,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 195,
                      "heading": "BIOL 558 — Current Topics in Marine Biology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nSeminar-style course focused on emerging research in marine biology, including climate change impacts, ocean acidification, and molecular tools in marine research.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nGraduate standing",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n2",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 601 — Research Methods and Data Analysis",
                "level": 3,
                "location": {
                  "line": 204,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 206,
                      "heading": "BIOL 601 — Research Methods and Data Analysis"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nTraining in experimental design, advanced statistics, and grant writing for biological research. Includes workshops on R and statistical modeling.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nGraduate standing",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 621 — Genomics and Proteomics",
                "level": 3,
                "location": {
                  "line": 215,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 217,
                      "heading": "BIOL 621 — Genomics and Proteomics"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nAnalysis of whole-genome data and protein expression profiles. Emphasis on next-generation sequencing, bioinformatics, and mass spectrometry.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 501 or instructor consent",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 698 — Graduate Seminar",
                "level": 3,
                "location": {
                  "line": 226,
                  "heading": "Graduate Courses (M.Sc./Ph.D. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 228,
                      "heading": "BIOL 698 — Graduate Seminar"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nWeekly seminar series featuring guest speakers, student research presentations, and discussions of current literature in genetics, conservation, and cell biology.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nGraduate standing",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n1",
                        "depth": 0
                      }
