            "sections": [
              {
                "title": "BIOL 101 — Principles of Biology",
                "level": 3,
                "location": {
                  "line": 10,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 12,
                      "heading": "BIOL 101 — Principles of Biology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nAn introduction to the fundamental concepts of biology, including cell structure, genetics, evolution, and ecology. Emphasis on the scientific method, laboratory research, and data analysis.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nNone",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 115 — Marine Diversity and Ecology",
                "level": 3,
                "location": {
                  "line": 21,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 23,
                      "heading": "BIOL 115 — Marine Diversity and Ecology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nA comprehensive exploration of marine ecosystems, focusing on organismal diversity, ecological interactions, and adaptation. Includes fieldwork in coastal environments and laboratory identification.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 101",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 121 — Introduction to Molecular Biology",
                "level": 3,
                "location": {
                  "line": 32,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 34,
                      "heading": "BIOL 121 — Introduction to Molecular Biology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nCovers the structure and function of biomolecules, DNA replication, gene expression, and genetic technologies. Laboratory work includes DNA extraction and electrophoresis.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 101",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 201 — Botany: Plant Life and Processes",
                "level": 3,
                "location": {
                  "line": 43,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 45,
                      "heading": "BIOL 201 — Botany: Plant Life and Processes"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nExamination of plant anatomy, physiology, and evolution. Study of plant responses to the environment, photosynthesis, and biodiversity in terrestrial ecosystems.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 101",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 221 — Genetics",
                "level": 3,
                "location": {
                  "line": 54,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 56,
                      "heading": "BIOL 221 — Genetics"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nFundamental principles of heredity, gene function, and genetic analysis in prokaryotes and eukaryotes. Focus on Mendelian genetics, chromosomal theory, and modern genomics.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 121",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 235 — Ecology",
                "level": 3,
                "location": {
                  "line": 65,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 67,
                      "heading": "BIOL 235 — Ecology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nConcepts in population, community, and ecosystem ecology. Topics include biodiversity, energy flow, nutrient cycling, and human impacts on biological systems. Includes field data collection and statistical analysis.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 101",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 243 — Research Methods in Biology",
                "level": 3,
                "location": {
                  "line": 76,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 78,
                      "heading": "BIOL 243 — Research Methods in Biology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nAn introduction to experimental design, scientific writing, and quantitative analysis in biological research. Students develop skills in critical reading, hypothesis testing, and use of laboratory and field techniques.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 101\nMATH 150 (or concurrent enrollment)",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 311 — Cell Biology",
                "level": 3,
                "location": {
                  "line": 88,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 90,
                      "heading": "BIOL 311 — Cell Biology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nStructure and function of eukaryotic cells, including membranes, organelles, and cytoskeleton. Explores cell communication, cycle regulation, and apoptosis with hands-on microscope work.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 121\nCHEM 110",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n4",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 318 — Marine Biology Field Studies",
                "level": 3,
                "location": {
                  "line": 100,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 102,
                      "heading": "BIOL 318 — Marine Biology Field Studies"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nAn immersive field-based course covering marine organisms, habitats, and ecological monitoring techniques. Includes a week-long research trip to the Gulf of Cendara.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 115\nBIOL 235",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 350 — Evolutionary Biology",
                "level": 3,
                "location": {
                  "line": 112,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 114,
                      "heading": "BIOL 350 — Evolutionary Biology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nExplores the mechanisms of evolution, natural selection, population genetics, and speciation. Integrates case studies and evolutionary analysis across major taxa.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 221\nBIOL 235",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 390 — Conservation Biology",
                "level": 3,
                "location": {
                  "line": 124,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 126,
                      "heading": "BIOL 390 — Conservation Biology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nPrinciples and practice of conserving biodiversity. Topics include species extinction, habitat loss, and ecological restoration. Includes group projects with local conservation agencies.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nBIOL 235",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "BIOL 410 — Senior Thesis",
                "level": 3,
                "location": {
                  "line": 135,
                  "heading": "Undergraduate Courses (B.Sc. in Biology)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 137,
                      "heading": "BIOL 410 — Senior Thesis"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Description:\nCulminating research project under faculty supervision. Students design and execute original research, culminating in a written thesis and public defense.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites:\nSenior standing in Biology\nBIOL 243",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours:\n6",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "Graduate Courses (M.Sc./Ph.D. in Biology)",
