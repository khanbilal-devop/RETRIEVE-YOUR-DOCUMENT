                      },
                      {
                        "text": "Prerequisites: Graduate standing and department approval",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nIndependent or faculty-supervised research leading to a substantial paper or project. Research topics must be approved by departmental faculty.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
