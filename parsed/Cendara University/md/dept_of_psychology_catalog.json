              {
                "title": "PSY 101: Introduction to Psychology",
                "level": 3,
                "location": {
                  "line": 7,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 8,
                      "heading": "PSY 101: Introduction to Psychology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nAn overview of the major theories, foundational concepts, and methods in psychology. Topics include perception, learning, motivation, development, and social behavior. Designed for students with no prior background in psychology.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: None",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "PSY 110: Research Methods in Psychology",
                "level": 3,
                "location": {
                  "line": 15,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 16,
                      "heading": "PSY 110: Research Methods in Psychology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 4",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nIntroduction to the scientific method as applied to psychological phenomena. Students learn experimental design, data collection, basic analysis, and ethical considerations. Includes laboratory sessions.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: PSY 101",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "PSY 211: Developmental Psychology",
                "level": 3,
                "location": {
                  "line": 23,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 24,
                      "heading": "PSY 211: Developmental Psychology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nExamination of the biological, cognitive, and social development of individuals from infancy through adulthood. Explores key theories and methodological approaches.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: PSY 101",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "PSY 218: Introduction to Cognitive Psychology",
                "level": 3,
                "location": {
                  "line": 31,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 32,
                      "heading": "PSY 218: Introduction to Cognitive Psychology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nExploration of mental processes such as attention, memory, language, perception, and problem-solving. Discussion of experimental findings and theoretical frameworks.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: PSY 101",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "PSY 230: Social Psychology",
                "level": 3,
                "location": {
                  "line": 39,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 40,
                      "heading": "PSY 230: Social Psychology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nInvestigation of how social factors influence individual behavior. Major topics include aggression, conformity, group dynamics, attitudes, stereotypes, and prejudice.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: PSY 101",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "PSY 250: Abnormal Psychology",
                "level": 3,
                "location": {
                  "line": 47,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 48,
                      "heading": "PSY 250: Abnormal Psychology"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nAnalysis of the definition, classification, and treatment of mental disorders. Includes an overview of anxiety, mood, psychotic, and personality disorders.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: PSY 101",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "PSY 312: Biological Bases of Behavior",
                "level": 3,
                "location": {
                  "line": 55,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 56,
                      "heading": "PSY 312: Biological Bases of Behavior"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nStudy of the neural and hormonal foundations of behavior, sensation, and motivation. Emphasizes connections between biological mechanisms and psychological processes.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: PSY 101, PSY 110",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
