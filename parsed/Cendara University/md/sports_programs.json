        "title": "Cendara University Sports Overview",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "Cendara University Sports Overview"
            },
            "text": "Cendara University is proud to offer a vibrant sports program that encourages student engagement, teamwork, and excellence both on and off the field. Our university hosts a wide range of competitive varsity teams, popular intramural leagues, and accessible recreational opportunities for the entire campus community."
          }
