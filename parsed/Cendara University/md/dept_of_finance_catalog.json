                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 28,
                      "heading": "FINA 201: Corporate Finance"
                    },
                    "text": "Description:\nA comprehensive study of the financial management practices within corporations. Topics include capital budgeting, cost of capital, working capital management, and financial planning."
