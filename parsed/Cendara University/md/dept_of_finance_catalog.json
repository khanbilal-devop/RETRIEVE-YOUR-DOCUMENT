                "location": {
                  "line": 9,
                  "heading": "Department of Finance and Accounting"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 10,
                      "heading": "FINA 101: Introduction to Financial Systems"
                    },
                    "text": "Description:\nAn overview of foundational concepts in finance, including the structure of financial systems, types of financial markets, and the role of financial institutions. Students will explore the basic functions of financial intermediaries and the regulatory environment."
                  },
                  {
                    "type": "list",
                    "location": {
                      "line": 13,
                      "heading": "FINA 101: Introduction to Financial Systems"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Prerequisites: None",
                        "depth": 0
                      },
                      {
                        "text": "Credit Hours: 3",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
