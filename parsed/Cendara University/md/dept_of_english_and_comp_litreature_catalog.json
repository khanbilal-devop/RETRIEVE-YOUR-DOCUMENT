              {
                "title": "ENGL 101: Introduction to Literature",
                "level": 3,
                "location": {
                  "line": 7,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 9,
                      "heading": "ENGL 101: Introduction to Literature"
                    },
                    "text": "Credits: 3\nDescription:\nFoundational exploration of major genres—poetry, fiction, and drama—from diverse cultures and historical periods. Emphasis on close reading, interpretive strategies, and critical discussion."
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 13,
                      "heading": "ENGL 101: Introduction to Literature"
                    },
                    "text": "Prerequisites: None"
                  }
                ],
                "sections": []
              },
              {
                "title": "ENGL 102: Fundamentals of Academic Writing",
                "level": 3,
                "location": {
                  "line": 17,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 19,
                      "heading": "ENGL 102: Fundamentals of Academic Writing"
                    },
                    "text": "Credits: 3\nDescription:\nPractice in formal writing for a variety of academic disciplines. Topics include thesis development, argumentation, research methods, and citation styles."
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 23,
                      "heading": "ENGL 102: Fundamentals of Academic Writing"
                    },
                    "text": "Prerequisites: None"
                  }
                ],
                "sections": []
              },
              {
                "title": "ENGL 203: British Literature I",
                "level": 3,
                "location": {
                  "line": 27,
                  "heading": "Undergraduate Courses"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 29,
                      "heading": "ENGL 203: British Literature I"
                    },
                    "text": "Credits: 3\nDescription:\nA survey of British literature from the Anglo-Saxon period through the 18th century, including key texts by Chaucer, Shakespeare, and Milton. Attention to literary traditions, historical contexts, and cultural influence."
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 33,
                      "heading": "ENGL 203: British Literature I"
                    },
                    "text": "Prerequisites: ENGL 101"
                  }
                ],
                "sections": []
              },
              {
