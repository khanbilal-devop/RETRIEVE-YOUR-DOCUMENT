        "title": "Cendara University Entrance Exam Information",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [],
        "sections": [
          {
            "title": "Overview",
            "level": 2,
            "location": {
              "line": 5,
              "heading": "Cendara University Entrance Exam Information"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 7,
                  "heading": "Overview"
                },
                "text": "Cendara University administers entrance examinations for select undergraduate and graduate academic programs to ensure a high standard of academic readiness and to appropriately place students in courses aligned with their skill levels. While most degree programs do not require a standardized university-wide entrance exam, certain competitive majors, specialized scholarship pathways, and direct-entry professional tracks require subject-based or aptitude testing."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 9,
                  "heading": "Overview"
                },
                "text": "Students are encouraged to review this section thoroughly and consult with their academic advisor or the Office of Admissions to determine whether an entrance exam applies to their intended course of study."
              }
            ],
            "sections": []
          },
          {
            "title": "Entrance Exam Requirements",
            "level": 2,
            "location": {
              "line": 13,
              "heading": "Cendara University Entrance Exam Information"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Which Programs Require Entrance Exams?",
                "level": 3,
                "location": {
                  "line": 15,
                  "heading": "Entrance Exam Requirements"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 17,
                      "heading": "Which Programs Require Entrance Exams?"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "School of Health Sciences\nBachelor of Science in Nursing, Bachelor of Public Health",
                        "depth": 0
                      },
                      {
                        "text": "Science Aptitude Exam (required for all first-time applicants)",
                        "depth": 1
                      },
                      {
                        "text": "School of Engineering and Applied Sciences\nBachelor of Engineering, Computer Science Major",
                        "depth": 0
                      },
                      {
                        "text": "Mathematics Proficiency Exam (required for all direct-entry applicants)",
                        "depth": 1
                      },
                      {
                        "text": "Honors College",
                        "depth": 0
                      },
                      {
                        "text": "Critical Reasoning Essay (for applicants seeking admission to Honors College)",
                        "depth": 1
                      },
                      {
                        "text": "Graduate School",
                        "depth": 0
                      },
                      {
                        "text": "Program-specific subject exams as required by departmental guidelines (e.g., Psychology GRE Subject for MA in Psychology)",
                        "depth": 1
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 28,
                      "heading": "Which Programs Require Entrance Exams?"
                    },
                    "text": "Note: General undergraduate admission does not require a university-wide entrance exam; most applicants are evaluated using prior academic transcripts, standardized testing (SAT/ACT), and supplemental materials."
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "Exam Registration Process",
            "level": 2,
            "location": {
              "line": 32,
              "heading": "Cendara University Entrance Exam Information"
            },
            "blocks": [],
            "sections": [
              {
                "title": "1. Determine Exam Eligibility",
                "level": 3,
                "location": {
                  "line": 34,
                  "heading": "Exam Registration Process"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 36,
                      "heading": "1. Determine Exam Eligibility"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Refer to your program page in the Online Program Catalog (https://catalog.cendara.edu) or consult with your assigned admissions counselor.",
                        "depth": 0
                      },
                      {
                        "text": "Check for exemption criteria (e.g., transfer of equivalent coursework, qualifying national/international test scores).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "2. Register for the Exam",
                "level": 3,
                "location": {
                  "line": 39,
                  "heading": "Exam Registration Process"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 41,
                      "heading": "2. Register for the Exam"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Log in to MyCendara at my.cendara.edu (https://my.cendara.edu).",
                        "depth": 0
                      },
                      {
                        "text": "Navigate to the “Entrance Exams” section under the Applicant Dashboard.",
                        "depth": 0
                      },
                      {
                        "text": "Select your required exam(s) and preferred examination session.",
                        "depth": 0
                      },
                      {
                        "text": "Review and confirm testing accommodations if applicable (see Accessibility Services below).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "3. Confirm Exam Schedule",
                "level": 3,
                "location": {
                  "line": 46,
                  "heading": "Exam Registration Process"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 48,
                      "heading": "3. Confirm Exam Schedule"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Once registered, you will receive an email within 48 hours containing:",
                        "depth": 0
                      },
                      {
                        "text": "Exam date and time",
                        "depth": 1
                      },
                      {
                        "text": "Testing location or access link (for online proctored exams)",
                        "depth": 1
                      },
                      {
                        "text": "Required identification and materials",
                        "depth": 1
                      },
                      {
                        "text": "Exam schedules are published at cendara.edu/entrance-exams/schedule (https://cendara.edu/entrance-exams/schedule).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
