          {
            "title": "Exam Content and Format",
            "level": 2,
            "location": {
              "line": 69,
              "heading": "Cendara University Entrance Exam Information"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Science Aptitude Exam",
                "level": 3,
                "location": {
                  "line": 71,
                  "heading": "Exam Content and Format"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 73,
                      "heading": "Science Aptitude Exam"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Duration: 90 minutes",
                        "depth": 0
                      },
                      {
                        "text": "Sections:",
                        "depth": 0
                      },
                      {
                        "text": "Biology basics (30%)",
                        "depth": 1
                      },
                      {
                        "text": "Chemistry fundamentals (35%)",
                        "depth": 1
                      },
                      {
                        "text": "Quantitative reasoning (25%)",
                        "depth": 1
                      },
                      {
                        "text": "Scientific reading comprehension (10%)",
                        "depth": 1
                      },
                      {
                        "text": "Question Types: Multiple-choice and short answer",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Mathematics Proficiency Exam",
                "level": 3,
                "location": {
                  "line": 81,
                  "heading": "Exam Content and Format"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 83,
                      "heading": "Mathematics Proficiency Exam"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Duration: 75 minutes",
                        "depth": 0
                      },
                      {
                        "text": "Sections:",
                        "depth": 0
                      },
                      {
                        "text": "Algebra and functions (40%)",
                        "depth": 1
                      },
                      {
                        "text": "Trigonometry and geometry (30%)",
                        "depth": 1
                      },
                      {
                        "text": "Data analysis and interpretation (30%)",
                        "depth": 1
                      },
                      {
                        "text": "Question Types: Computer-adaptive multiple-choice",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Critical Reasoning Essay",
                "level": 3,
                "location": {
                  "line": 90,
                  "heading": "Exam Content and Format"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 92,
                      "heading": "Critical Reasoning Essay"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Duration: 45 minutes",
                        "depth": 0
                      },
                      {
                        "text": "Format: Typed essay response to one prompt",
                        "depth": 0
                      },
                      {
                        "text": "Evaluation: Clarity of argument, logic, use of evidence, and writing mechanics",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Graduate Subject Exams",
                "level": 3,
                "location": {
                  "line": 96,
                  "heading": "Exam Content and Format"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 98,
                      "heading": "Graduate Subject Exams"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Content and format are determined by each department; see graduate program entry in the Catalog (https://catalog.cendara.edu/graduate).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "Scoring and Results",
            "level": 2,
            "location": {
              "line": 102,
              "heading": "Cendara University Entrance Exam Information"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 104,
                  "heading": "Scoring and Results"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Exams are scored within 10 business days.",
                    "depth": 0
                  },
                  {
                    "text": "Undergraduate exam scores are posted to your MyCendara Applicant Dashboard.",
                    "depth": 1
                  },
                  {
                    "text": "Graduate subject exam results are communicated by program departments.",
                    "depth": 1
                  },
                  {
                    "text": "Minimum Passing Scores:",
                    "depth": 0
                  },
                  {
                    "text": "Science Aptitude Exam: 68% overall, no section below 55%",
                    "depth": 1
                  },
                  {
                    "text": "Mathematics Proficiency Exam: 65%",
                    "depth": 1
                  },
                  {
                    "text": "Critical Reasoning Essay: Score of 8/12 from faculty readers",
                    "depth": 1
                  },
                  {
                    "text": "Retake Policy:\nStudents who do not meet minimum scores may register for one exam retake per admission cycle. Requests for additional attempts require appeal to the Admissions Review Committee.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Exam Day Guidelines",
            "level": 2,
            "location": {
              "line": 116,
              "heading": "Cendara University Entrance Exam Information"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 118,
                  "heading": "Exam Day Guidelines"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Arrive at least 30 minutes before your scheduled start time.",
                    "depth": 0
                  },
                  {
                    "text": "Bring a government-issued photo ID and your CUSID exam ticket (print or digital).",
                    "depth": 0
                  },
                  {
                    "text": "Permitted items:",
                    "depth": 0
                  },
                  {
                    "text": "Non-programmable calculator (for Math exam)",
                    "depth": 1
                  },
                  {
                    "text": "Pencils/pens (where applicable)",
                    "depth": 1
                  },
                  {
                    "text": "Water in clear bottle",
                    "depth": 1
                  },
                  {
                    "text": "Prohibited items:",
                    "depth": 0
                  },
                  {
                    "text": "Study aids, notes, or electronic devices (other than those required for online testing)",
                    "depth": 1
                  },
                  {
                    "text": "Wearable technology",
                    "depth": 1
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 128,
                  "heading": "Exam Day Guidelines"
                },
                "text": "Accommodations for students with disabilities are available. Contact accessibility@cendara.edu at least two weeks before your scheduled exam."
              }
            ],
            "sections": []
          },
          {
            "title": "Frequently Asked Questions",
            "level": 2,
            "location": {
              "line": 132,
              "heading": "Cendara University Entrance Exam Information"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Do all applicants need to take an entrance exam?",
                "level": 3,
                "location": {
                  "line": 134,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 136,
                      "heading": "Do all applicants need to take an entrance exam?"
                    },
                    "text": "No. Only certain academic programs or tracks require an entrance exam (see above). Most applicants qualify through their prior academic record and submitted standardized scores."
                  }
                ],
                "sections": []
              },
              {
                "title": "What if I am unable to attend the scheduled exam date?",
                "level": 3,
                "location": {
                  "line": 138,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 140,
                      "heading": "What if I am unable to attend the scheduled exam date?"
                    },
                    "text": "Contact the Office of Admissions at exams@cendara.edu as soon as possible. Make-up sessions or remote testing may be arranged for verifiable reasons such as illness, travel difficulties, or overlapping commitments."
                  }
                ],
                "sections": []
              },
              {
                "title": "How should I prepare for my entrance exam?",
                "level": 3,
                "location": {
                  "line": 142,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 144,
                      "heading": "How should I prepare for my entrance exam?"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Review the sample test materials and practice guides available at cendara.edu/entrance-exams/prep (https://cendara.edu/entrance-exams/prep).",
                        "depth": 0
                      },
                      {
                        "text": "Attend an online information session or contact your department for recommended resources.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Can international students take exams online?",
                "level": 3,
                "location": {
                  "line": 147,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 149,
                      "heading": "Can international students take exams online?"
                    },
                    "text": "Yes. Online, proctored versions of all entrance exams are available for international and remote applicants. Ensure your technology meets the system requirements published on the website."
                  }
                ],
                "sections": []
              },
              {
                "title": "Are there exam fees?",
                "level": 3,
                "location": {
                  "line": 151,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 153,
                      "heading": "Are there exam fees?"
                    },
                    "text": "The first sitting of any required entrance exam is included with your application. Retake or late registration fees are $45 per exam. Fee waivers are available for eligible students (see Financial Services (mailto:finance@cendara.edu))."
                  }
                ],
                "sections": []
              }
            ]
          },
