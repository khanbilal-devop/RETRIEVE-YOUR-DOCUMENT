          {
            "title": "4. Campus Life and Community",
            "level": 2,
            "location": {
              "line": 142,
              "heading": "Cendara University International Student Guide"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Living On Campus",
                "level": 3,
                "location": {
                  "line": 144,
                  "heading": "4. Campus Life and Community"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 146,
                      "heading": "Living On Campus"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Residence Halls: On-campus housing for undergraduates; meal plans available.",
                        "depth": 0
                      },
                      {
                        "text": "Typical Room: Double occupancy, shared bathroom, Wi-Fi, communal kitchens.",
                        "depth": 1
                      },
                      {
                        "text": "International Living Community (ILC): Cultural programming and peer support.",
                        "depth": 1
                      },
                      {
                        "text": "Graduate Housing: Limited apartments available; apply early.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Dining",
                "level": 3,
                "location": {
                  "line": 151,
                  "heading": "4. Campus Life and Community"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 153,
                      "heading": "Dining"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Dining Commons: Diverse menu with global cuisine options (vegetarian, halal, gluten-free available).",
                        "depth": 0
                      },
                      {
                        "text": "Campus Cafés: Java Junction and The Garden Table offer coffee, snacks, and study space.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Student Organizations",
                "level": 3,
                "location": {
