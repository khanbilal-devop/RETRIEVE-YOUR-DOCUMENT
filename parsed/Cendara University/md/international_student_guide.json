                  "heading": "4. Campus Life and Community"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 158,
                      "heading": "Student Organizations"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "International Students Association (ISA): Social events, cultural festivals, and mentorship programs.",
                        "depth": 0
                      },
                      {
                        "text": "Multicultural Resource Center: Affinity groups, language exchange, and interfaith dialogues.",
                        "depth": 0
                      },
                      {
                        "text": "Student Government Association: Advocacy and leadership opportunities.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Cultural Programs",
                "level": 3,
                "location": {
                  "line": 162,
                  "heading": "4. Campus Life and Community"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 164,
                      "heading": "Cultural Programs"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "International Night (October): Music, dance, and food from around the world.",
                        "depth": 0
                      },
                      {
                        "text": "Lunar New Year Festival (February), Diwali Celebration (November), Eid Gathering (April).",
                        "depth": 0
                      },
                      {
                        "text": "Cendara Unity Dialogues: Dialogue series on belonging, identity, and intercultural understanding.",
                        "depth": 0
                      }
                    ]
