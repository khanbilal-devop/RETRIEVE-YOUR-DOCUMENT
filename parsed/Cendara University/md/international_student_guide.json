            ]
          },
          {
            "title": "5. Health, Wellness, and Safety",
            "level": 2,
            "location": {
              "line": 170,
              "heading": "Cendara University International Student Guide"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Health Insurance",
                "level": 3,
                "location": {
                  "line": 172,
                  "heading": "5. Health, Wellness, and Safety"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 174,
                      "heading": "Health Insurance"
                    },
                    "text": "All international students are required to enroll in the Cendara University Student Health Insurance Plan (SHIP):"
                  },
                  {
                    "type": "list",
                    "location": {
                      "line": 176,
                      "heading": "Health Insurance"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Coverage: On-campus Health Center services, local hospitals, mental health counseling, prescriptions, emergency care.",
                        "depth": 0
                      },
                      {
                        "text": "Annual Cost (2024–2025): $1,350",
                        "depth": 0
                      },
                      {
                        "text": "Waivers: Available if you have comparable insurance.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Health Services",
                "level": 3,
                "location": {
                  "line": 180,
                  "heading": "5. Health, Wellness, and Safety"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 182,
                      "heading": "Health Services"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Campus Health Center: Primary care, vaccinations, urgent care, and referral services. Open Monday–Friday, 8:00 a.m.–5:30 p.m.",
                        "depth": 0
                      },
                      {
                        "text": "Counseling Services: Free, confidential counseling with multicultural staff, plus support groups for international students.",
                        "depth": 0
                      },
                      {
                        "text": "Accessibility Services: Academic accommodations and assistive technology support.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Campus Safety",
                "level": 3,
                "location": {
                  "line": 186,
                  "heading": "5. Health, Wellness, and Safety"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 188,
                      "heading": "Campus Safety"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "24/7 Campus Security patrols and emergency call boxes throughout campus.",
                        "depth": 0
                      },
                      {
                        "text": "Night Owl free campus shuttle (operates 7:00 p.m.–2:00 a.m.).",
                        "depth": 0
                      },
                      {
                        "text": "Safety App: Cendara Guardian (real-time alerts and check-in).",
                        "depth": 0
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 192,
                      "heading": "Campus Safety"
                    },
                    "text": "For emergencies, dial 911 from any phone.\nNon-emergency Campus Security: (747) 229-6500"
                  }
                ],
                "sections": []
              }
            ]
          },
          {
