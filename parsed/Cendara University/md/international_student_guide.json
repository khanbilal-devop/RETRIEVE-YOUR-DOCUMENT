                      "line": 212,
                      "heading": "Taxes"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "All international students, even those without income, must file Form 8843 annually.",
                        "depth": 0
                      },
                      {
                        "text": "Guidance webinars available each spring (see global.cendara.edu/taxinfo).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
