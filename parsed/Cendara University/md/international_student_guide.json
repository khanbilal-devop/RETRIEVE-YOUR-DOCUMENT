                      "heading": "Academic Support Services"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "International Tutoring Center: Offers English language and subject tutoring—weekly group sessions and private appointments.",
                        "depth": 0
                      },
                      {
                        "text": "Writing Studio: Specialists help develop writing and presentation skills, including citation practices.",
                        "depth": 0
                      },
                      {
                        "text": "Academic Advising: Dedicated advisors assist with course selection, degree planning, and adjustment to new academic norms.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
