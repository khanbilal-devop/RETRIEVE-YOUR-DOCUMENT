        "sections": [
          {
            "title": "Welcome Letter from the Office of Global Engagement",
            "level": 2,
            "location": {
              "line": 5,
              "heading": "Cendara University International Student Guide"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 7,
                  "heading": "Welcome Letter from the Office of Global Engagement"
                },
                "text": "Dear International Students,"
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 9,
                  "heading": "Welcome Letter from the Office of Global Engagement"
                },
                "text": "Welcome to Cendara University! Whether you are joining us from across the globe or continuing your studies far from home, we are thrilled to have you as a valued member of our vibrant and diverse campus community. Navigating a new country and academic environment can be both exciting and challenging, but please know you are not alone—our entire community is eager to support your journey and help you thrive."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 11,
                  "heading": "Welcome Letter from the Office of Global Engagement"
                },
                "text": "This guide provides essential information to help you transition smoothly to life at Cendara University and in the city of Albaire. Inside, you’ll find details about orientation, support services, immigration compliance, academics, and student life, as well as the many ways you can connect with others and make the most of your experience."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 13,
                  "heading": "Welcome Letter from the Office of Global Engagement"
                },
                "text": "We look forward to supporting your goals and learning from your unique perspectives."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 15,
                  "heading": "Welcome Letter from the Office of Global Engagement"
                },
                "text": "Warm regards,\nEvelyn Zhao, Director\nOffice of Global Engagement\nglobal@cendara.edu"
              }
            ],
            "sections": []
          },
