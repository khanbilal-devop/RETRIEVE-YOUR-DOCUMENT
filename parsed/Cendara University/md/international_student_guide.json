                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 206,
                      "heading": "Off-Campus Employment"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Curricular Practical Training (CPT): For internships directly related to your major, after 1 academic year.",
                        "depth": 0
                      },
                      {
                        "text": "Optional Practical Training (OPT): Up to 12 months of work authorization upon program completion (F-1 students).",
                        "depth": 0
                      },
                      {
                        "text": "Social Security Number (SSN): Required for employment; apply after securing a job offer.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
