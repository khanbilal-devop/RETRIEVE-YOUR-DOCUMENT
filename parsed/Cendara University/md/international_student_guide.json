          {
            "title": "1. Arrival and Orientation",
            "level": 2,
            "location": {
              "line": 35,
              "heading": "Cendara University International Student Guide"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Pre-Arrival Checklist",
                "level": 3,
                "location": {
                  "line": 37,
                  "heading": "1. Arrival and Orientation"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 39,
                      "heading": "Pre-Arrival Checklist"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Confirm your student visa (F-1/J-1) is approved and valid.",
                        "depth": 0
                      },
                      {
                        "text": "Purchase airline tickets, aiming to arrive 7–10 days before classes start.",
                        "depth": 0
                      },
                      {
                        "text": "Arrange temporary or permanent housing in advance.",
                        "depth": 0
                      },
                      {
                        "text": "Submit required immunization records to Health Services.",
                        "depth": 0
                      },
                      {
                        "text": "Register for International Student Orientation via global.cendara.edu/orientation.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Transportation to Campus",
                "level": 3,
                "location": {
                  "line": 45,
                  "heading": "1. Arrival and Orientation"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 47,
                      "heading": "Transportation to Campus"
                    },
                    "text": "Cendara University is located in central Albaire, approximately 35 minutes from Sable International Airport (SBL).\nTransportation options include:"
                  },
                  {
                    "type": "list",
                    "location": {
                      "line": 50,
                      "heading": "Transportation to Campus"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Airport Welcome Shuttle: Complimentary pick-up service during orientation week (reservation required).",
                        "depth": 0
                      },
                      {
                        "text": "City Taxi Service: Flat rate of $40 to campus hotels and residence halls.",
                        "depth": 0
                      },
                      {
                        "text": "Riverton Bus Line: Bus #12 connects the airport to downtown; fare: $3.50 (cash/credit).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "International Student Orientation",
                "level": 3,
                "location": {
                  "line": 54,
                  "heading": "1. Arrival and Orientation"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 56,
                      "heading": "International Student Orientation"
                    },
                    "text": "Fall 2024 Orientation: August 14–18, 2024\nAll new international students must attend the five-day orientation, which covers:"
                  },
                  {
                    "type": "list",
                    "location": {
                      "line": 59,
                      "heading": "International Student Orientation"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Immigration regulations & visa maintenance",
                        "depth": 0
                      },
                      {
                        "text": "Campus resources and facilities tour",
                        "depth": 0
                      },
                      {
                        "text": "Academic integrity and classroom expectations",
                        "depth": 0
                      },
                      {
                        "text": "Health insurance enrollment",
                        "depth": 0
                      },
                      {
                        "text": "Banking & mobile phone setup",
                        "depth": 0
                      },
                      {
                        "text": "City walking tour and cultural adjustment workshops",
                        "depth": 0
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 66,
                      "heading": "International Student Orientation"
                    },
                    "text": "Peer Mentors will be on hand to answer your questions and help you meet fellow new students."
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "2. Immigration and Legal Matters",
            "level": 2,
            "location": {
              "line": 70,
              "heading": "Cendara University International Student Guide"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Visa Status Requirements",
                "level": 3,
                "location": {
                  "line": 72,
                  "heading": "2. Immigration and Legal Matters"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 74,
                      "heading": "Visa Status Requirements"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Maintain a valid passport (at least 6 months into the future).",
                        "depth": 0
                      },
                      {
                        "text": "Full-time enrollment:",
                        "depth": 0
                      },
                      {
                        "text": "Undergraduates: 12 credit hours/semester",
                        "depth": 1
                      },
                      {
                        "text": "Graduates: 9 credit hours/semester",
                        "depth": 1
                      },
                      {
                        "text": "Report any address changes to the Office of Global Engagement within 10 days.",
                        "depth": 0
                      },
                      {
                        "text": "Do not accept employment off-campus without prior authorization.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "SEVIS Registration",
                "level": 3,
                "location": {
                  "line": 81,
                  "heading": "2. Immigration and Legal Matters"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 83,
                      "heading": "SEVIS Registration"
                    },
                    "text": "You must check in with the Office of Global Engagement within 3 days of arrival. Please bring:"
                  },
                  {
                    "type": "list",
                    "location": {
                      "line": 85,
                      "heading": "SEVIS Registration"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Passport (with valid visa)",
                        "depth": 0
                      },
                      {
                        "text": "I-20 (F-1)/DS-2019 (J-1) document",
                        "depth": 0
                      },
                      {
                        "text": "I-94 Arrival/Departure record",
                        "depth": 0
                      },
                      {
                        "text": "Proof of local address",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Travel/Leave of Absence",
                "level": 3,
                "location": {
                  "line": 90,
                  "heading": "2. Immigration and Legal Matters"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 92,
                      "heading": "Travel/Leave of Absence"
                    },
                    "text": "Contact your international advisor before leaving the U.S. for more than 30 days or if you plan to take a semester off.\nRe-entering the U.S.? Your I-20/DS-2019 must be signed by a DSO within the last 12 months."
                  }
                ],
                "sections": []
              },
              {
                "title": "Common Immigration Violations",
                "level": 3,
                "location": {
                  "line": 95,
                  "heading": "2. Immigration and Legal Matters"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 97,
                      "heading": "Common Immigration Violations"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Failing to enroll full-time without pre-approved authorization",
                        "depth": 0
                      },
                      {
                        "text": "Unauthorized employment",
                        "depth": 0
                      },
                      {
                        "text": "Expired I-20 or DS-2019",
                        "depth": 0
                      },
                      {
                        "text": "Not updating address promptly",
                        "depth": 0
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 102,
                      "heading": "Common Immigration Violations"
                    },
                    "text": "Questions? Meet with a Designated School Official (email: isss@cendara.edu)."
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "3. Academic Expectations and Support",
            "level": 2,
            "location": {
              "line": 106,
              "heading": "Cendara University International Student Guide"
            },
            "blocks": [],
            "sections": [
              {
                "title": "The American Classroom",
                "level": 3,
                "location": {
                  "line": 108,
                  "heading": "3. Academic Expectations and Support"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 110,
                      "heading": "The American Classroom"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Active participation is strongly encouraged. Be prepared to ask and answer questions, and contribute to discussions.",
                        "depth": 0
                      },
                      {
                        "text": "Academic honesty is essential. Plagiarism, cheating, and unauthorized collaboration can result in disciplinary action.",
                        "depth": 0
                      },
                      {
                        "text": "Professors hold weekly office hours for additional help—attending is recommended.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
