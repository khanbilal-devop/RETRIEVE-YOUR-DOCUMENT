                  {
                    "title": "CS101: Introduction to Computer Science",
                    "level": 4,
                    "location": {
                      "line": 21,
                      "heading": "Course Listings"
                    },
                    "blocks": [
                      {
                        "type": "list",
                        "location": {
                          "line": 23,
                          "heading": "CS101: Introduction to Computer Science"
                        },
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nAn overview of the foundational concepts of computer science. Topics include algorithms, programming fundamentals, computer hardware, operating systems, and current trends in the field. Designed for students with little or no prior programming experience.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: None",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "CS115: Programming Fundamentals with Python",
                    "level": 4,
                    "location": {
                      "line": 31,
                      "heading": "Course Listings"
                    },
                    "blocks": [
                      {
                        "type": "list",
                        "location": {
                          "line": 33,
                          "heading": "CS115: Programming Fundamentals with Python"
                        },
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nIntroduction to structured problem-solving and algorithmic thinking using Python. Covers variable types, control structures, functions, simple data structures, and debugging practices.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: None",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 4",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
                    "title": "CS130: Data Structures and Algorithms",
                    "level": 4,
                    "location": {
                      "line": 41,
                      "heading": "Course Listings"
                    },
                    "blocks": [
                      {
                        "type": "list",
                        "location": {
                          "line": 43,
                          "heading": "CS130: Data Structures and Algorithms"
                        },
                        "ordered": false,
                        "items": [
                          {
                            "text": "Description:\nConcepts and implementation of fundamental data structures (lists, stacks, queues, trees, graphs) and basic algorithms (sorting, searching, recursion). Emphasis on algorithmic analysis and computational complexity.",
                            "depth": 0
                          },
                          {
                            "text": "Prerequisites: CS115",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
                  {
