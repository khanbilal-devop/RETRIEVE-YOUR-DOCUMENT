                          {
                            "text": "Prerequisites: CS101 or instructor consent",
                            "depth": 0
                          },
                          {
                            "text": "Credit Hours: 3",
                            "depth": 0
                          }
                        ]
                      }
                    ],
                    "sections": []
                  },
