            "sections": [
              {
                "title": "Q: Will my account number or debit card change?",
                "level": 3,
                "location": {
                  "line": 60,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 61,
                      "heading": "Q: Will my account number or debit card change?"
                    },
                    "text": "A: No, your account number remains the same. Debit card change is only if you opt for exclusive salary account variants."
                  }
                ],
                "sections": []
              },
              {
                "title": "Q: What if my salary is not credited for a few months?",
                "level": 3,
                "location": {
                  "line": 63,
                  "heading": "Frequently Asked Questions"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 64,
                      "heading": "Q: What if my salary is not credited for a few months?"
                    },
                    "text": "A: If salary is not credited for 3-6 months (as per bank policy), the account may revert to a regular savings account with applicable minimum balance criteria."
                  }
                ],
                "sections": []
              },
              {
                "title": "Q: Can I convert online?",
