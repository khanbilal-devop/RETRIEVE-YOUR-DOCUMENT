    "sections": [
      {
        "title": "Do's and Don'ts About 3rd Party Accessories & Electrical Accessories for Your Car",
        "level": 1,
        "location": {
          "line": 1
        },
        "blocks": [
          {
            "type": "paragraph",
            "location": {
              "line": 3,
              "heading": "Do's and Don'ts About 3rd Party Accessories & Electrical Accessories for Your Car"
            },
            "text": "When it comes to enhancing your Aventro vehicle with aftermarket or third-party accessories, especially electrical ones, it’s critical to protect your investment, warranty, and safety. Here’s a comprehensive guide outlining the essential do’s and don’ts."
          }
        ],
        "sections": [
          {
            "title": "Do’s",
            "level": 2,
            "location": {
              "line": 7,
              "heading": "Do's and Don'ts About 3rd Party Accessories & Electrical Accessories for Your Car"
            },
            "blocks": [],
            "sections": [
              {
                "title": "1. Do Research Thoroughly",
                "level": 3,
                "location": {
                  "line": 9,
                  "heading": "Do’s"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 10,
                      "heading": "1. Do Research Thoroughly"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Always check the compatibility of the accessory with your specific Aventro model and variant.",
                        "depth": 0
                      },
                      {
                        "text": "Look for genuine reviews and ratings from other users and professionals.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "2. Do Buy from Reputed Dealers",
                "level": 3,
                "location": {
                  "line": 13,
                  "heading": "Do’s"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 14,
                      "heading": "2. Do Buy from Reputed Dealers"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Purchase accessories, especially electrical ones, from trusted and reputed vendors.",
                        "depth": 0
                      },
                      {
                        "text": "Ensure that the accessory comes with proper certification and warranty.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "3. Do Consult Aventro Authorized Service",
                "level": 3,
                "location": {
                  "line": 17,
                  "heading": "Do’s"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 18,
                      "heading": "3. Do Consult Aventro Authorized Service"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Before installation, consult your nearest Aventro Service Center or authorized dealer for advice.",
                        "depth": 0
                      },
                      {
                        "text": "Get their approval for high-voltage or safety-critical electrical changes (e.g., battery packs, infotainment systems).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "4. Do Verify Warranty Implications",
                "level": 3,
                "location": {
                  "line": 21,
                  "heading": "Do’s"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 22,
                      "heading": "4. Do Verify Warranty Implications"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Ask specifically about warranty impact: certified installations at Aventro Service Centers are less likely to void your warranty.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "5. Do Ensure Professional Installation",
                "level": 3,
                "location": {
                  "line": 24,
                  "heading": "Do’s"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 25,
                      "heading": "5. Do Ensure Professional Installation"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Have all accessories, particularly electrical or electronic ones, fitted by trained technicians.",
                        "depth": 0
                      },
                      {
                        "text": "Use proper connectors, fuses, and avoid splicing into factory wiring harnesses.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "6. Do Prioritize Safety Standards",
                "level": 3,
                "location": {
                  "line": 28,
                  "heading": "Do’s"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 29,
                      "heading": "6. Do Prioritize Safety Standards"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Only use accessories compliant with BIS (Bureau of Indian Standards) and other safety norms.",
                        "depth": 0
                      },
                      {
                        "text": "For electrical parts, ensure proper ratings for voltage and current.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "7. Do Retain All Purchase and Installation Records",
                "level": 3,
                "location": {
                  "line": 32,
                  "heading": "Do’s"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 33,
                      "heading": "7. Do Retain All Purchase and Installation Records"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Keep invoices, product manuals, and warranties safe.",
                        "depth": 0
                      },
                      {
                        "text": "Maintain a record of all modifications and installations for future reference.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
          {
            "title": "Don’ts",
            "level": 2,
            "location": {
              "line": 38,
              "heading": "Do's and Don'ts About 3rd Party Accessories & Electrical Accessories for Your Car"
            },
            "blocks": [],
            "sections": [
              {
                "title": "1. Don’t Compromise Vehicle Warranty",
                "level": 3,
                "location": {
                  "line": 40,
                  "heading": "Don’ts"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 41,
                      "heading": "1. Don’t Compromise Vehicle Warranty"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Installing uncertified or incompatible accessories can void your company warranty—consult Aventro first!",
                        "depth": 0
                      },
                      {
                        "text": "Never bypass or disable factory safety features (like airbags, sensors, anti-theft systems).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "2. Don’t Use Low-Cost, Sub-Standard Parts",
                "level": 3,
                "location": {
                  "line": 44,
                  "heading": "Don’ts"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 45,
                      "heading": "2. Don’t Use Low-Cost, Sub-Standard Parts"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Avoid cheap, uncertified or counterfeit electrical accessories—they can cause malfunction, fire, or permanent damage.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "3. Don’t Overload the Electrical System",
                "level": 3,
                "location": {
                  "line": 47,
                  "heading": "Don’ts"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 48,
                      "heading": "3. Don’t Overload the Electrical System"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Never install accessories (high-powered audio, extra lights, etc.) that draw excessive power without proper upgrades (e.g., alternator, wiring).",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "4. Don’t Attempt DIY Installation for Complex Accessories",
                "level": 3,
                "location": {
                  "line": 50,
                  "heading": "Don’ts"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 51,
                      "heading": "4. Don’t Attempt DIY Installation for Complex Accessories"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Never attempt to install complex electrical or electronic components yourself unless you’re certified.",
                        "depth": 0
                      },
                      {
                        "text": "Avoid modifying or cutting factory wires, as this can cause electrical faults.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "5. Don’t Ignore Warning Signs After Installation",
                "level": 3,
                "location": {
                  "line": 54,
                  "heading": "Don’ts"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 55,
                      "heading": "5. Don’t Ignore Warning Signs After Installation"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "If you notice dashboard warnings, flickering lights, or malfunctioning electronics post-installation, stop using the accessory immediately and consult a service center.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "6. Don’t Block Airbags or Sensors",
                "level": 3,
                "location": {
                  "line": 57,
                  "heading": "Don’ts"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 58,
                      "heading": "6. Don’t Block Airbags or Sensors"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Never install accessories (phone holders, seat covers, dashboards gadgets) that block airbags, seat belt pre-tensioners, or sensors.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "7. Don’t Forget Insurance Implications",
                "level": 3,
                "location": {
                  "line": 60,
                  "heading": "Don’ts"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 61,
                      "heading": "7. Don’t Forget Insurance Implications"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Inform your insurer if you add any expensive or electrical accessories—undisclosed modifications may impact future claims.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
