          {
            "title": "Placement Process",
            "level": 2,
            "location": {
              "line": 84,
              "heading": "Cendara University Placement Report"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 86,
                  "heading": "Placement Process"
                },
                "ordered": true,
                "items": [
                  {
                    "text": "Registration: Eligible final-year students register with the Center for Career Development and submit CVs.",
                    "depth": 0
                  },
                  {
                    "text": "Pre-Placement Training: Includes resume workshops, interview preparation, group discussions, and aptitude tests.",
                    "depth": 0
                  },
                  {
                    "text": "Company Presentations: Employers visit campus (virtually or in-person) to describe roles and organizational culture.",
                    "depth": 0
                  },
                  {
                    "text": "Application & Shortlisting: Students apply to open positions; employers shortlist candidates based on their criteria.",
                    "depth": 0
                  },
                  {
                    "text": "Interviews & Assessments: Conducted on campus or offsite, followed by HR and technical interviews.",
                    "depth": 0
                  },
                  {
                    "text": "Offer Rollout: Successful candidates receive offer letters; assistance provided in decision-making and negotiations.",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 93,
                  "heading": "Placement Process"
                },
                "text": "Note: Specialized support is provided for international students, differently abled students, and those seeking opportunities in non-traditional sectors."
              }
            ],
            "sections": []
