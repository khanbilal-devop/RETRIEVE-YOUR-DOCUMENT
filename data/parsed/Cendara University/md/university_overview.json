          },
          {
            "title": "Looking Forward",
            "level": 2,
            "location": {
              "line": 105,
              "heading": "Founding History & Milestones"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 107,
                  "heading": "Looking Forward"
                },
                "text": "Cendara University continually adapts to serve current and future generations. With an alumni network over 46,000 strong and a vibrant, diverse student body, the university remains true to its founding spirit: inspiring minds and transforming lives through education."
              }
