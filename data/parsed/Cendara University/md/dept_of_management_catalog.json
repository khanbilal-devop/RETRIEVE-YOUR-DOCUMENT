                      "heading": "MGMT 112: Organizational Behavior"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nExplores the psychological and sociological principles underlying individual and group behavior in organizations. Topics include motivation, leadership styles, team dynamics, and conflict resolution.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: MGMT 101",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
