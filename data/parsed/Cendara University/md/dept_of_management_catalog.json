            "sections": [
              {
                "title": "MGMT 101: Principles of Management",
                "level": 3,
                "location": {
                  "line": 16,
                  "heading": "Undergraduate Courses (B.B.A.)"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 17,
                      "heading": "MGMT 101: Principles of Management"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Credits: 3",
                        "depth": 0
                      },
                      {
                        "text": "Description:\nAn introduction to the fundamentals of management, including planning, organizing, leading, and controlling within organizations. Emphasis is placed on the evolution of management thought, ethical frameworks, and decision-making processes.",
                        "depth": 0
                      },
                      {
                        "text": "Prerequisites: None",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
