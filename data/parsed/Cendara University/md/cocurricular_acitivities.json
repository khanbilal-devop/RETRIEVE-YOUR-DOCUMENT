            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 122,
                  "heading": "Annual Campus-Wide Co-Curricular Events"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Cendara Club Fair\nEvery September, over 50 clubs and organizations host exhibitions, demonstrations, and sign-ups on the Quad. New students connect with club leadership and join campus life.",
                    "depth": 0
                  },
                  {
                    "text": "Global Cuisine Night\nOrganized by cultural societies and the International Students’ Association. Features food, performances, and cultural presentations from over 15 countries. (February 10, 2024)",
                    "depth": 0
                  },
                  {
                    "text": "Volunteer Impact Day\nA service-oriented event with partnerships throughout Vallis City—students participate in park clean-ups, mentoring, and blood drives.",
                    "depth": 0
                  },
                  {
                    "text": "Arts in the Park\nOutdoor visual and performing arts showcase supported by the Literary Arts Collective and Performing Arts Society.",
                    "depth": 0
                  }
                ]
              }
