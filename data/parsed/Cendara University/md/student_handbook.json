                        "Marginal Pass"
                      ],
                      [
                        "F",
                        "0-59%",
                        "0.00",
                        "Fail"
                      ]
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Attendance Policy",
                "level": 3,
                "location": {
                  "line": 80,
                  "heading": "Academic Policies"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 82,
                      "heading": "Attendance Policy"
                    },
                    "text": "Students are expected to attend all scheduled classes. Absences exceeding 20% of class meetings may result in grade penalties or withdrawal from the course. Medical or emergency absences require official documentation."
                  }
                ],
                "sections": []
              },
              {
                "title": "Academic Integrity Policy",
                "level": 3,
                "location": {
                  "line": 84,
                  "heading": "Academic Policies"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 86,
                      "heading": "Academic Integrity Policy"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Plagiarism: All work must be original. Copying or paraphrasing without citation is prohibited.",
                        "depth": 0
                      },
                      {
                        "text": "Cheating: Using unauthorized materials during exams or assignments is strictly forbidden.",
                        "depth": 0
                      },
                      {
                        "text": "Collaboration: Only permitted when expressly authorized by the instructor.",
                        "depth": 0
                      },
                      {
                        "text": "Consequences: Violations may result in a failing grade, formal warning, suspension, or expulsion.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Course Registration and Withdrawal",
                "level": 3,
                "location": {
                  "line": 91,
                  "heading": "Academic Policies"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 93,
                      "heading": "Course Registration and Withdrawal"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Registration opens twice a year: May 10 for Fall, November 15 for Spring.",
                        "depth": 0
                      },
                      {
                        "text": "Add/Drop Period: First two weeks of the semester.",
                        "depth": 0
                      },
                      {
                        "text": "Withdrawal deadline: End of Week 10. W on transcript, no impact on GPA.",
                        "depth": 0
                      },
                      {
                        "text": "Late withdrawal requests require approval from the Dean of Students.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              }
            ]
          },
