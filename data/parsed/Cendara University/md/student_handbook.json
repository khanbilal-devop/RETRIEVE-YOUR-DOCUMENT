          {
            "title": "Welcome Message",
            "level": 2,
            "location": {
              "line": 32,
              "heading": "Cendara University Student Handbook"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 34,
                  "heading": "Welcome Message"
                },
                "text": "Dear Cendara University Students,"
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 36,
                  "heading": "Welcome Message"
                },
                "text": "Welcome to Cendara University! We are excited to have you as part of our vibrant, diverse, and innovative community. This handbook is designed to be your guide to campus life, helping you navigate academic expectations, student support resources, community standards, and the myriad opportunities available. If you have any questions, please reach out to Student Affairs at student.affairs@cendara.edu."
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 38,
                  "heading": "Welcome Message"
                },
                "text": "Wishing you a successful year ahead,"
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 40,
                  "heading": "Welcome Message"
                },
                "text": "Dr. Susan A. Forelli\nVice President for Student Affairs"
              }
            ],
            "sections": []
          },
          {
            "title": "Campus Overview",
            "level": 2,
            "location": {
              "line": 45,
              "heading": "Cendara University Student Handbook"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 47,
                  "heading": "Campus Overview"
                },
                "text": "Cendara University is located in the thriving city of Larkspur, blending urban energy with the serenity of a landscaped, modern campus. Founded in 1927, Cendara is home to over 8,000 undergraduate and graduate students. Our campus includes:"
              },
              {
                "type": "list",
                "location": {
                  "line": 49,
                  "heading": "Campus Overview"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Arches Academic Complex: Home to the Faculty of Sciences and lecture halls.",
                    "depth": 0
                  },
                  {
                    "text": "Silverleaf Library: Centrally located with extensive study spaces and digital resources.",
                    "depth": 0
                  },
                  {
                    "text": "Aspen Residence Hall: A state-of-the-art dormitory for first-year students.",
                    "depth": 0
                  },
                  {
                    "text": "Willows Student Center: Hub for student organizations and recreational activities.",
                    "depth": 0
                  },
                  {
                    "text": "Cendara Athletics Pavilion: Fitness center, swimming pool, and courts.",
                    "depth": 0
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Academic Policies",
            "level": 2,
            "location": {
              "line": 57,
              "heading": "Cendara University Student Handbook"
            },
            "blocks": [],
            "sections": [
              {
                "title": "Academic Standards",
                "level": 3,
                "location": {
                  "line": 59,
                  "heading": "Academic Policies"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 61,
                      "heading": "Academic Standards"
                    },
                    "text": "All students must maintain satisfactory academic progress, defined as a minimum cumulative GPA of 2.0 for undergraduates and 3.0 for graduate students, and complete at least 67% of attempted credits per semester."
                  }
                ],
                "sections": []
              },
              {
                "title": "Grading System",
                "level": 3,
                "location": {
                  "line": 63,
                  "heading": "Academic Policies"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 65,
                      "heading": "Grading System"
                    },
                    "text": "Cendara University uses the following grading scale:"
                  },
                  {
                    "type": "table",
                    "location": {
                      "line": 67,
                      "heading": "Grading System"
                    },
                    "header": [
                      "Grade",
                      "Percentage",
                      "GPA Points",
                      "Description"
                    ],
                    "rows": [
                      [
                        "A",
                        "93-100%",
                        "4.00",
                        "Excellent"
                      ],
                      [
                        "A-",
                        "90-92%",
                        "3.70",
                        ""
                      ],
                      [
                        "B+",
                        "87-89%",
                        "3.30",
                        "Very Good"
                      ],
                      [
                        "B",
