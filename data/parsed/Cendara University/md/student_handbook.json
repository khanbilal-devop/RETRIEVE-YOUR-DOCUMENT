              {
                "title": "Residence Life",
                "level": 3,
                "location": {
                  "line": 115,
                  "heading": "Campus Life"
                },
                "blocks": [
                  {
                    "type": "list",
                    "location": {
                      "line": 117,
                      "heading": "Residence Life"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Residence Halls: Aspen, Birch, Linden, and Juniper Halls.",
                        "depth": 0
                      },
                      {
                        "text": "Room Assignment: Incoming first-years guaranteed housing; upperclass students apply via housing lottery.",
                        "depth": 0
                      },
                      {
                        "text": "Resident Advisors (RAs): Each floor has an RA for support and community events.",
                        "depth": 0
                      },
                      {
                        "text": "Quiet Hours: 10:00 PM – 8:00 AM weekdays; midnight – 9:00 AM weekends.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Dining Services",
                "level": 3,
                "location": {
                  "line": 122,
                  "heading": "Campus Life"
