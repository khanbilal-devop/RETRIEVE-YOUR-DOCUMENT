          {
            "title": "Code of Conduct",
            "level": 2,
            "location": {
              "line": 194,
              "heading": "Cendara University Student Handbook"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 196,
                  "heading": "Code of Conduct"
                },
                "text": "Cendara University expects all students to uphold principles of respect, responsibility, and integrity. The following are strictly prohibited:"
              },
              {
                "type": "list",
                "location": {
                  "line": 198,
                  "heading": "Code of Conduct"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Harassment, discrimination, or hate speech of any kind",
                    "depth": 0
                  },
                  {
                    "text": "Violence, threats, or intimidation",
                    "depth": 0
                  },
                  {
                    "text": "Theft or destruction of property",
                    "depth": 0
                  },
                  {
                    "text": "Alcohol or drug use on campus (unless permitted at registered, age-verified events)",
                    "depth": 0
                  },
                  {
                    "text": "Academic dishonesty (see Academic Integrity Policy)",
                    "depth": 0
                  }
                ]
              },
              {
                "type": "paragraph",
                "location": {
                  "line": 204,
                  "heading": "Code of Conduct"
                },
                "text": "Violations are subject to investigation and disciplinary action, including warnings, probation, suspension, and expulsion. Appeals can be made through the Office of Student Conduct."
              }
            ],
            "sections": []
          },
          {
            "title": "Safety & Security",
            "level": 2,
            "location": {
              "line": 208,
              "heading": "Cendara University Student Handbook"
            },
            "blocks": [
              {
                "type": "list",
                "location": {
                  "line": 210,
                  "heading": "Safety & Security"
                },
                "ordered": false,
                "items": [
                  {
                    "text": "Campus Safety Office: Located in Willows Student Center (open 24/7)",
                    "depth": 0
                  },
                  {
                    "text": "Emergency Contacts: (473) 555-0111 (emergency), (473) 555-0120 (non-emergency)",
                    "depth": 0
                  },
                  {
                    "text": "Safe Ride Program: Free rides from 6:00 PM to 2:00 AM daily",
                    "depth": 0
                  },
                  {
                    "text": "Blue Light Phones: 25 locations across campus for immediate assistance",
                    "depth": 0
                  },
                  {
                    "text": "Fire Drills & Emergency Procedures: Conducted each semester—see posted instructions.",
                    "depth": 0
                  },
                  {
                    "text": "Personal Property Tips:",
                    "depth": 0
                  },
                  {
                    "text": "Lock doors and bikes at all times.",
                    "depth": 1
                  },
                  {
                    "text": "Report suspicious activity.",
                    "depth": 1
                  },
                  {
                    "text": "Register laptops and valuables with Campus Safety.",
                    "depth": 1
                  }
                ]
              }
            ],
            "sections": []
          },
          {
            "title": "Diversity & Inclusion",
            "level": 2,
            "location": {
              "line": 222,
              "heading": "Cendara University Student Handbook"
            },
            "blocks": [
              {
                "type": "paragraph",
                "location": {
                  "line": 224,
                  "heading": "Diversity & Inclusion"
                },
                "text": "Cendara University is committed to building a welcoming and equitable community. The Office of Diversity, Equity, & Inclusion (ODEI) leads campus-wide efforts in:"
              },
              {
                "type": "list",
                "location": {
                  "line": 226,
                  "heading": "Diversity & Inclusion"
                },
                "ordered": false,
