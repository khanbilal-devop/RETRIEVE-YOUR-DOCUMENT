                    "type": "list",
                    "location": {
                      "line": 124,
                      "heading": "Dining Services"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Dining Halls: Oakleaf Commons and Willow Café. Vegetarian, vegan, and gluten-free meal options available.",
                        "depth": 0
                      },
                      {
                        "text": "Meal Plans: All resident students must purchase a meal plan (Silver, Gold, Platinum).",
                        "depth": 0
                      },
                      {
                        "text": "Hours: 7:00 AM – 10:00 PM weekdays; 8:00 AM – 9:00 PM weekends.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
                "title": "Campus Events",
                "level": 3,
                "location": {
                  "line": 128,
                  "heading": "Campus Life"
                },
                "blocks": [
                  {
                    "type": "paragraph",
                    "location": {
                      "line": 130,
                      "heading": "Campus Events"
                    },
                    "text": "Signature campus events include:"
                  },
                  {
                    "type": "list",
                    "location": {
                      "line": 132,
                      "heading": "Campus Events"
                    },
                    "ordered": false,
                    "items": [
                      {
                        "text": "Welcome Week: Social, academic, and orientation activities for all new students, August 28 – September 2.",
                        "depth": 0
                      },
                      {
                        "text": "Spring Carnival: April 21–23 — music, food trucks, inflatables, and art showcases.",
                        "depth": 0
                      },
                      {
                        "text": "Research Expo: November 3 — student research presentations and guest speakers.",
                        "depth": 0
                      },
                      {
                        "text": "Cultural Night: March 10 — celebrating campus diversity with performance and cuisine.",
                        "depth": 0
                      }
                    ]
                  }
                ],
                "sections": []
              },
              {
